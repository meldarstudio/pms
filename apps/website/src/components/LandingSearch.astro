---
import StaySearch from "@/components/StaySearch.astro";
import { getLang, useTranslations } from "@/i18n/utils";
import { roomsHref } from "@/lib/reservation/links";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<div id="availability" class="scroll-offset">
  <StaySearch action={roomsHref(lang)} submit={t("hero.bookCta")} />
</div>
