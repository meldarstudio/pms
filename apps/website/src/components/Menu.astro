---
import Logo from "@/assets/manantial-logo.svg";
import Mark from "@/assets/manantial-mark.svg";
import { phoneNumber, mapsUrl, address } from "@/lib/constants";
import LangSelect from "@/components/LangSelect.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLang, useTranslations } from "@/i18n/utils";
import { formatPhoneNumber } from "@/lib/utils";
import { roomsHref } from "@/lib/reservation/links";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const homeHref = getRelativeLocaleUrl(lang);
const pathname = Astro.url.pathname.replace(/\/$/, "");
const overlay = pathname === homeHref.replace(/\/$/, "");
const bookOnPage =
  overlay || pathname === getRelativeLocaleUrl(lang, "habitaciones").replace(/\/$/, "");
const bookHref = bookOnPage ? "#availability" : roomsHref(lang);
const bookLabel = t("nav.book");

const navLinks = [
  { title: t("nav.rooms"), href: getRelativeLocaleUrl(lang, "habitaciones") },
  { title: t("nav.churin"), href: getRelativeLocaleUrl(lang, "churin") },
];
---

<navigation-menu
  class:list={[
    "group z-50 block w-full pt-[env(safe-area-inset-top)] data-scrolled:shadow-xs",
    {
      "fixed top-0 bg-transparent data-menu-expanded:bg-white data-scrolled:bg-white": overlay,
      "sticky top-0 bg-white": !overlay,
    },
  ]}
>
  <header>
    <div
      class:list={[
        "border-b",
        {
          "border-transparent group-data-menu-expanded:border-stone-100 group-data-scrolled:border-stone-100":
            overlay,
          "border-stone-100": !overlay,
        },
      ]}
    >
      <div
        class:list={[
          "font-source-sans-3 mx-auto flex w-full max-w-7xl items-center justify-between px-4 text-sm font-medium tracking-widest uppercase md:px-8",
          {
            "text-white/80 group-data-menu-expanded:text-stone-500 group-data-scrolled:text-stone-500":
              overlay,
            "text-stone-500": !overlay,
          },
        ]}
      >
        <div class="flex items-center gap-6">
          <a
            href={`tel:${phoneNumber}`}
            class="flex min-h-11 items-center gap-2 underline-offset-2 hover:underline"
          >
            <svg
              viewBox="0 0 24 24"
              class="size-4 fill-none stroke-current stroke-2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
              ></path>
            </svg>
            <span>{formatPhoneNumber(phoneNumber)}</span>
          </a>
          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden min-h-11 items-center gap-2 underline-offset-2 hover:underline md:flex"
          >
            <svg
              class="size-4 fill-none stroke-current stroke-2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
              ></path>
            </svg>
            <span>{address}</span>
          </a>
        </div>
        <LangSelect />
      </div>
    </div>
    <div class="mx-auto grid w-full max-w-7xl grid-cols-[1fr_auto_1fr] items-center gap-3 px-4 py-2.5 md:flex md:justify-between md:gap-6 md:px-8 md:py-4">
      <button
        id="menu-toggle"
        class:list={[
          "-ml-2.5 flex size-11 items-center justify-center justify-self-start md:hidden",
          {
            "group-data-menu-expanded:focus-visible:outline-accent-700 group-data-scrolled:focus-visible:outline-accent-700 text-white group-data-menu-expanded:text-stone-900 group-data-scrolled:text-stone-900 hover:bg-white/10 group-data-menu-expanded:hover:bg-stone-100 group-data-scrolled:hover:bg-stone-100 focus-visible:outline-white":
              overlay,
            "text-stone-900 hover:bg-stone-100": !overlay,
          },
        ]}
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t("menu.open")}
        data-label-open={t("menu.open")}
        data-label-close={t("menu.close")}
      >
        <span class="sr-only" data-sr-open={t("menu.open")} data-sr-close={t("menu.close")}>
          {t("menu.open")}
        </span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.75"
          stroke="currentColor"
          class="size-6"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6.75h16.5M3.75 12h16.5M6.75 17.25h13.5"
            id="menu-icon-hamburger"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"
            id="menu-icon-close"
          ></path>
        </svg>
      </button>

      <a
        href={homeHref}
        class="inline-flex min-h-11 min-w-0 shrink-0 items-center justify-center"
        aria-label={t("brand.name")}
        translate="no"
      >
        <Mark class="h-9 w-auto md:hidden" />
        <Logo
          class:list={[
            "hidden h-10 w-auto md:block",
            {
              "text-white group-data-menu-expanded:text-stone-900 group-data-scrolled:text-stone-900":
                overlay,
              "text-stone-900": !overlay,
            },
          ]}
        />
      </a>

      <div class="flex items-center gap-8 justify-self-end">
        <nav aria-label={t("nav.primary")} class="hidden md:block">
          <ul class="flex items-center gap-8">
            {navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    "font-source-sans-3 inline-flex min-h-11 items-center py-3 text-sm font-medium tracking-widest uppercase",
                    {
                      "hover:text-accent-400 group-data-scrolled:hover:text-accent-700 text-white group-data-scrolled:text-stone-900":
                        overlay,
                      "hover:text-accent-700 text-stone-900": !overlay,
                    },
                  ]}
                >
                  {link.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <a
          id="menu-book"
          href={bookHref}
          class:list={[
            "font-source-sans-3 bg-accent-500 text-accent-950 hover:bg-accent-400 inline-flex min-h-11 items-center px-3 text-sm font-medium tracking-widest whitespace-nowrap uppercase md:px-4",
            {
              "group-data-menu-expanded:focus-visible:outline-accent-700 group-data-scrolled:focus-visible:outline-accent-700 focus-visible:outline-white":
                overlay,
            },
          ]}
        >
          {bookLabel}
        </a>
      </div>
    </div>
  </header>

  <nav
    id="mobile-menu"
    class="flex-1 flex-col overflow-y-auto overscroll-contain bg-white md:hidden"
    aria-hidden="true"
    aria-label={t("nav.mobile")}
    inert
  >
    <ul class="flex flex-1 flex-col">
      {navLinks.map((link) => (
        <li class="border-b border-stone-200">
          <a
            href={link.href}
            class="font-source-sans-3 block px-4 py-4 text-sm font-medium tracking-widest text-stone-900 uppercase hover:bg-stone-100"
          >
            {link.title}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <script>
    class NavigationMenu extends HTMLElement {
      private toggleButton = this.querySelector<HTMLButtonElement>("#menu-toggle");
      private inertElements: HTMLElement[] = [];

      connectedCallback() {
        this.toggleButton?.addEventListener("click", this.toggleMenu);
        document.addEventListener("keydown", this.handleKeyDown);
        window.addEventListener("resize", this.handleResize);
        window.addEventListener("scroll", this.handleScroll, { passive: true });
        this.handleScroll();
        this.querySelectorAll("#mobile-menu a, #menu-book").forEach((link) => {
          link.addEventListener("click", () => this.setMenuState(false));
        });
      }

      disconnectedCallback() {
        this.toggleButton?.removeEventListener("click", this.toggleMenu);
        document.removeEventListener("keydown", this.handleKeyDown);
        window.removeEventListener("resize", this.handleResize);
        window.removeEventListener("scroll", this.handleScroll);
        this.setBackgroundInert(false);
      }

      private toggleMenu = () => {
        const isOpen = document.body.hasAttribute("data-menu-expanded");
        this.setMenuState(!isOpen, isOpen);
      };

      private handleKeyDown = (e: KeyboardEvent) => {
        if (!document.body.hasAttribute("data-menu-expanded")) return;

        if (e.key === "Escape") {
          this.setMenuState(false, true);
          return;
        }

        if (e.key === "Tab") {
          this.containFocus(e);
        }
      };

      private handleResize = () => {
        if (window.matchMedia("(min-width: 48rem)").matches) {
          this.setMenuState(false);
        }
      };

      private handleScroll = () => {
        const scrolled = window.scrollY > 0;
        this.toggleAttribute("data-scrolled", scrolled);
        this.querySelector("header")?.toggleAttribute("data-scrolled", scrolled);
      };

      private getFocusableElements = () =>
        Array.from(
          this.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])',
          ),
        ).filter(
          (element) => element.offsetParent !== null && !element.closest<HTMLElement>("[inert]"),
        );

      private containFocus = (event: KeyboardEvent) => {
        const focusableElements = this.getFocusableElements();
        const first = focusableElements[0];
        const last = focusableElements.at(-1);
        if (!first || !last) return;

        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      };

      private setBackgroundInert = (isOpen: boolean) => {
        if (isOpen) {
          this.inertElements = Array.from(document.body.children).filter(
            (element): element is HTMLElement => element instanceof HTMLElement && element !== this,
          );
          this.inertElements.forEach((element) => {
            element.inert = true;
          });
          return;
        }

        this.inertElements.forEach((element) => {
          element.inert = false;
        });
        this.inertElements = [];
      };

      private setMenuState = (isOpen: boolean, restoreFocus = false) => {
        const mobileMenu = this.querySelector<HTMLElement>("#mobile-menu");
        const btn = this.toggleButton;
        if (btn) {
          const openLabel = btn.dataset.labelOpen ?? "";
          const closeLabel = btn.dataset.labelClose ?? "";
          btn.setAttribute("aria-label", isOpen ? closeLabel : openLabel);
          const sr = btn.querySelector<HTMLSpanElement>(".sr-only");
          if (sr) {
            sr.textContent = isOpen ? (btn.dataset.srClose ?? "") : (btn.dataset.srOpen ?? "");
          }
        }
        btn?.setAttribute("aria-expanded", isOpen.toString());
        mobileMenu?.setAttribute("aria-hidden", (!isOpen).toString());
        if (mobileMenu) mobileMenu.inert = !isOpen;
        this.toggleAttribute("data-menu-expanded", isOpen);
        document.body.toggleAttribute("data-menu-expanded", isOpen);
        this.setBackgroundInert(isOpen);

        if (isOpen) {
          requestAnimationFrame(() => {
            if (!this.hasAttribute("data-menu-expanded")) return;
            mobileMenu?.querySelector<HTMLElement>("a[href]")?.focus();
          });
        } else if (restoreFocus) {
          btn?.focus();
        }
      };
    }

    customElements.define("navigation-menu", NavigationMenu);
  </script>
</navigation-menu>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a[href="#availability"]').forEach((link) => {
    link.addEventListener("click", (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
        return;
      const availability = document.getElementById("availability");
      if (!availability) return;
      event.preventDefault();
      requestAnimationFrame(() => {
        if (window.location.hash !== "#availability") {
          window.history.pushState(null, "", "#availability");
        }
        document.getElementById("stay-check-in")?.focus({ preventScroll: true });
        availability.scrollIntoView({
          behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
            ? "instant"
            : "smooth",
          block: "start",
        });
      });
    });
  });
</script>
