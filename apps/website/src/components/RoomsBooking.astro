---
import { getWhatsAppLink } from "@/lib/constants";
import { getLang, useTranslations } from "@/i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const bookHref = getWhatsAppLink(t("whatsapp.prefill"));
const steps = [
  t("rooms.how.step1"),
  t("rooms.how.step2"),
  t("rooms.how.step3"),
  t("rooms.how.step4"),
] as const;
---

<section class="bg-white text-stone-900">
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-4 py-8 md:grid-cols-12 md:px-8 md:py-16 lg:py-24">
    <div class="md:col-span-5">
      <p class="font-source-sans-3 text-accent-700 text-xs font-medium tracking-widest uppercase">
        {t("rooms.how.kicker")}
      </p>
      <h2 class="mt-4 text-2xl font-semibold text-pretty md:text-3xl lg:text-4xl">
        {t("rooms.how.title")}
      </h2>
      <p class="mt-8 max-w-md leading-relaxed text-pretty text-stone-600">
        {t("rooms.rates.note")}
      </p>
      <a
        href={bookHref}
        target="_blank"
        rel="noopener noreferrer"
        class="font-source-sans-3 bg-accent-500 text-accent-950 hover:bg-accent-400 mt-8 inline-flex min-h-11 w-fit items-center px-8 text-sm font-medium tracking-widest uppercase"
      >
        {t("rooms.how.cta")}
      </a>
    </div>
    <ol class="list-none md:col-span-6 md:col-start-7">
      {steps.map((step, index) => (
        <li class="grid grid-cols-[2rem_1fr] gap-5">
          <div class="flex flex-col items-center self-stretch">
            <span
              class="border-accent-200 bg-accent-100 text-accent-950 flex size-8 shrink-0 items-center justify-center border text-sm font-semibold"
              aria-hidden="true"
            >
              {index + 1}
            </span>
            {index < steps.length - 1 && <span class="bg-accent-200 w-px flex-1" />}
          </div>
          <p
            class:list={[
              "pt-1 leading-relaxed text-pretty text-stone-700",
              { "pb-10": index < steps.length - 1 },
            ]}
          >
            {step}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>
