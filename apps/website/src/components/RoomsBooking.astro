---
import { getImage } from "astro:assets";
import RoomsBookingIsland, { type RoomView } from "@/components/rooms/RoomsBooking";
import type { StayDetails } from "@/components/rooms/RoomCard";
import { roomsBookingText } from "@/components/rooms/text";
import { getLang, useTranslations } from "@/i18n/utils";
import { hotelServices, roomAmenities, type StayDetailId } from "@/lib/included";
import { reservationApiUrl } from "@/lib/reservation/api";
import { reviewStepHref } from "@/lib/reservation/links";
import { ratePlanCodes } from "@/lib/reservation/search";
import { staySearchCopy } from "@/lib/reservation/stay-copy";
import { rooms } from "@/lib/rooms";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const photoSizes =
  "(min-width: 80rem) 25rem, (min-width: 64rem) 32vw, (min-width: 48rem) 48vw, 100vw";
const photoWidths = [480, 720, 960, 1280];

const views: RoomView[] = await Promise.all(
  rooms.map(async (room) => ({
    id: room.id,
    name: t(room.nameKey),
    beds: t(room.bedsKey),
    area: t(room.areaKey),
    sleeps: room.sleeps,
    pmsRoomTypeId: room.pmsRoomTypeId ?? null,
    photos: await Promise.all(
      room.gallery.map(async (photo) => {
        const widths = photoWidths.filter((width) => width <= photo.src.width);
        const [card, full] = await Promise.all([
          getImage({
            src: photo.src,
            width: widths.at(-1) ?? photo.src.width,
            widths,
            sizes: photoSizes,
            format: "webp",
          }),
          getImage({
            src: photo.src,
            width: Math.min(photo.src.width, 2400),
            format: "webp",
            quality: 85,
          }),
        ]);
        return {
          src: card.src,
          srcSet: card.srcSet.attribute,
          sizes: photoSizes,
          width: photo.src.width,
          height: photo.src.height,
          alt: t(photo.altKey),
          full: full.src,
        };
      }),
    ),
  })),
);
const translate = (items: readonly { id: StayDetailId; labelKey: Parameters<typeof t>[0] }[]) =>
  items.map((item) => ({ id: item.id, label: t(item.labelKey) }));
const details: StayDetails = {
  inRoom: translate(roomAmenities),
  hotel: translate(hotelServices),
};
---

<div data-rooms-booking>
  <script is:inline define:vars={{ roomIds: rooms.map((room) => room.id), ratePlanCodes }}>
    {
      const params = new URLSearchParams(window.location.search);
      if (
        params.get("checkIn") &&
        params.get("checkOut") &&
        roomIds.includes(params.get("room")) &&
        ratePlanCodes.includes(params.get("plan"))
      ) {
        document.currentScript.parentElement.setAttribute("data-resume-rates", "");
      }
    }
  </script>
  <RoomsBookingIsland
    client:load
    lang={lang}
    apiBase={reservationApiUrl}
    reviewHref={reviewStepHref(lang)}
    rooms={views}
    details={details}
    text={roomsBookingText(t)}
    searchCopy={staySearchCopy(t, t("reservation.search.submit"))}
  />
</div>

<style is:global>
  [data-rooms-booking][data-resume-rates] [data-room-step] {
    display: none;
  }
  [data-rooms-booking][data-resume-rates] [data-rate-loading] {
    display: block;
  }
  [data-rooms-booking][data-resume-rates] [role="status"] {
    visibility: hidden;
  }
</style>
