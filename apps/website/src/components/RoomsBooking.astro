---
import RoomsBookingIsland from "@/components/rooms/RoomsBooking.svelte";
import type { RoomView, RoomsBookingProps, StayDetails } from "@/components/rooms/room-view";
import { roomsBookingText } from "@/components/rooms/text";
import { getLang, useTranslations } from "@/i18n/utils";
import { hotelServices, roomAmenities, type StayDetailId } from "@/lib/included";
import { PUBLIC_PMS_API_URL } from "astro:env/client";
import { getRelativeLocaleUrl } from "astro:i18n";
import { formatMoney } from "@/lib/reservation/format";
import { reviewStepHref } from "@/lib/reservation/links";
import { staySearchCopy } from "@/lib/reservation/stay-copy";
import { rooms } from "@/lib/rooms";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { roomPage } = Astro.locals;
if (!roomPage) throw new Error("Room booking requires room page middleware data");
const { initial, reference } = roomPage;
let referenceRates: RoomsBookingProps["referenceRates"] = { kind: "unavailable" };
if (reference.kind === "found") {
  const { currency, roomTypes } = reference.result;
  const byType = new Map(roomTypes.map(({ id, baseRateCents }) => [id, baseRateCents]));
  referenceRates = {
    kind: "found",
    amounts: Object.fromEntries(
      rooms.flatMap((room) => {
        const cents = room.pmsRoomTypeId && byType.get(room.pmsRoomTypeId);
        return typeof cents === "number" ? [[room.id, formatMoney(cents, currency)]] : [];
      }),
    ),
  };
}
const searchCopy = staySearchCopy(t, t("reservation.search.submit"));
const views: RoomView[] = rooms.map((room) => ({
  id: room.id,
  name: t(room.nameKey),
  beds: t(room.bedsKey),
  area: t(room.areaKey),
  sleeps: room.sleeps,
  pmsRoomTypeId: room.pmsRoomTypeId ?? null,
  photos: room.gallery.map((photo) => ({
    ...photo.variants,
    width: photo.src.width,
    height: photo.src.height,
    alt: t(photo.altKey),
  })),
}));
const translate = (items: readonly { id: StayDetailId; labelKey: Parameters<typeof t>[0] }[]) =>
  items.map((item) => ({ id: item.id, label: t(item.labelKey) }));
const details: StayDetails = {
  inRoom: translate(roomAmenities),
  hotel: translate(hotelServices),
};
---

<RoomsBookingIsland
  client:load
  lang={lang}
  apiBase={PUBLIC_PMS_API_URL}
  reviewHref={reviewStepHref(lang)}
  rooms={views}
  details={details}
  text={roomsBookingText(t)}
  searchCopy={searchCopy}
  action={getRelativeLocaleUrl(lang, "habitaciones")}
  {initial}
  {referenceRates}
/>

<style is:global>
  @media (width < 48rem) {
    body:has([data-continue-bar]) {
      padding-bottom: calc(4.5rem + env(safe-area-inset-bottom));
    }
  }
</style>
