---
import Layout from "@/layouts/Layout.astro";
import type { LegalDocument } from "@/lib/legal/document";

interface Props {
  document: LegalDocument;
}

const { document } = Astro.props;
---

<Layout title={`${document.title} | Hotel Manantial`} description={document.description}>
  <article class="mx-auto max-w-3xl px-4 py-10 text-stone-900 md:px-8 md:py-16">
    <h1 class="text-3xl leading-tight font-semibold text-pretty md:text-4xl">{document.title}</h1>
    <p class="mt-3 text-sm text-stone-600">{document.effective}</p>
    <p class="mt-6 leading-relaxed text-pretty">{document.intro}</p>
    {document.sections.map((section) => (
      <section class="mt-10">
        <h2 class="text-xl font-semibold text-pretty md:text-2xl">{section.heading}</h2>
        {section.paragraphs?.map((paragraph) => (
          <p class="mt-4 leading-relaxed text-pretty text-stone-700">{paragraph}</p>
        ))}
        {section.items && (
          <ul class="mt-4 list-disc space-y-2 pl-5 leading-relaxed text-pretty text-stone-700">
            {section.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
      </section>
    ))}
  </article>
</Layout>
