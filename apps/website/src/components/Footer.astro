---
import { FacebookLogo, InstagramLogo, TiktokLogo } from "phosphor-svelte";
import { getRelativeLocaleUrl } from "astro:i18n";
import Logo from "@/assets/manantial-logo.svg";
import ComplaintNotice from "@/components/complaints/ComplaintNotice.astro";
import { socials } from "@/constants";
import { getLang, useTranslations } from "@/i18n/utils";
import {
  address,
  email,
  getWhatsAppLink,
  legalName,
  mapsUrl,
  phoneNumber,
  taxId,
} from "@/lib/constants";
import { formatPhoneNumber } from "@/lib/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const year = new Date().getFullYear();

const siteLinks = [
  { title: t("nav.rooms"), href: getRelativeLocaleUrl(lang, "habitaciones") },
  { title: t("nav.churin"), href: getRelativeLocaleUrl(lang, "churin") },
  {
    title: t("footer.whatsapp"),
    href: getWhatsAppLink(t("whatsapp.prefill")),
    label: t("footer.whatsappLabel").replace("{phone}", formatPhoneNumber(phoneNumber)),
    external: true,
  },
  {
    title: t("footer.email"),
    href: `mailto:${email}`,
    label: t("footer.emailLabel").replace("{email}", email),
  },
];

const legalLinks = [
  { title: t("footer.conditions"), href: getRelativeLocaleUrl(lang, "condiciones-de-reserva") },
  { title: t("footer.privacy"), href: getRelativeLocaleUrl(lang, "privacidad") },
];

const socialIcons = {
  Facebook: FacebookLogo,
  Instagram: InstagramLogo,
  TikTok: TiktokLogo,
};
---

<footer class="border-t border-stone-200 bg-white pb-[env(safe-area-inset-bottom)] text-stone-600">
  <div class="mx-auto flex max-w-7xl flex-col items-center gap-6 px-4 py-14 text-center md:px-8">
    <a
      href={getRelativeLocaleUrl(lang)}
      class="inline-flex p-0.5"
      aria-label={t("brand.name")}
      translate="no"
    >
      <Logo class="h-12 w-auto text-stone-900" />
    </a>
    <a
      href={mapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={t("footer.addressLabel").replace("{address}", address)}
      class="inline-flex min-h-11 items-center underline-offset-4 hover:text-stone-900 hover:underline"
      translate="no"
    >
      {address}
    </a>
    <nav aria-label={t("footer.links")}>
      <ul class="flex flex-wrap justify-center gap-x-8">
        {siteLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-label={link.label}
              {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              class="font-source-sans-3 inline-flex min-h-11 items-center text-sm tracking-widest text-stone-900 uppercase underline-offset-4 hover:underline"
            >
              {link.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <ul class="flex gap-1" aria-label={t("footer.socials")}>
      {socials.map((social) => {
        const Icon = socialIcons[social.name as keyof typeof socialIcons];
        return (
          <li>
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.name}
              class="inline-flex size-11 items-center justify-center rounded-full text-stone-600 transition-colors hover:bg-stone-100 hover:text-stone-900"
            >
              <Icon size={22} aria-hidden="true" />
            </a>
          </li>
        );
      })}
    </ul>
  </div>
  <div class="border-t border-stone-200">
    <div class="mx-auto flex max-w-7xl flex-col items-center gap-3 px-4 py-6 text-center text-sm md:px-8">
      <ComplaintNotice />
      <nav aria-label={t("footer.legal")}>
        <ul class="flex flex-wrap justify-center gap-x-6">
          {legalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="inline-flex min-h-11 items-center underline-offset-4 hover:text-stone-900 hover:underline"
              >
                {link.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <p class="flex flex-col md:flex-row md:gap-2">
        <span>
          © {year} <span translate="no">{legalName}</span>
        </span>
        <span aria-hidden="true" class="hidden md:inline">
          ·
        </span>
        <span translate="no">RUC {taxId}</span>
      </p>
    </div>
  </div>
</footer>
