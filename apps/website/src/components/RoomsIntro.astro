---
import { getLang, useTranslations } from "@/i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section class="bg-stone-100 text-stone-900">
  <div class="mx-auto max-w-7xl px-4 pt-8 pb-6 md:px-8 md:pt-16 md:pb-8 lg:pt-24">
    <p class="font-source-sans-3 text-xs font-medium tracking-widest text-stone-600 uppercase">
      {t("brand.subtitle")}
    </p>
    <h1 class="mt-3 text-3xl font-semibold text-pretty sm:text-4xl md:text-5xl">
      {t("rooms.pageTitle")}
    </h1>
    <p class="font-source-sans-3 mt-4 flex items-center gap-2 text-stone-700 md:text-lg">
      <span aria-hidden="true" class="bg-accent-500 size-1.5 shrink-0 rounded-full"></span>
      {t("pets.welcome")}
    </p>
    <span class="bg-accent-500 mt-6 block h-1 w-16" aria-hidden="true"></span>
  </div>
</section>
