---
import plaza from "@/assets/churin-plaza-armas.webp";
import BookingBand from "@/components/BookingBand.astro";
import Whatsapp from "@/icons/Whatsapp.svg";
import { attractions } from "@/lib/attractions";
import { address, getWhatsAppLink, mapsUrl } from "@/lib/constants";
import { getLang, useTranslations } from "@/i18n/utils";
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const roomsHref = getRelativeLocaleUrl(lang, "habitaciones");
const bookHref = getWhatsAppLink(t("whatsapp.prefill"));

const facts = [
  { value: t("churin.fact.altitudeValue"), label: t("churin.fact.altitude") },
  { value: t("churin.fact.fromLimaValue"), label: t("churin.fact.fromLima") },
  { value: t("churin.fact.driveTimeValue"), label: t("churin.fact.driveTime") },
  { value: t("churin.fact.temp"), label: t("churin.fact.baths") },
];

const pools = attractions.map((pool) => ({
  id: pool.id,
  name: pool.name,
  drive: t(pool.driveKey),
  body: t(pool.bodyKey),
  image: pool.image,
  alt: t(pool.imageAltKey),
}));
---

<article class="bg-white text-stone-900">
  <div class="flex flex-col">
    <div class="order-2 mx-auto grid max-w-7xl gap-10 px-4 py-8 md:px-8 md:py-16 lg:order-1 lg:grid-cols-12 lg:py-24">
      <div class="lg:col-span-7">
        <p class="font-source-sans-3 text-xs font-medium tracking-widest text-stone-500 uppercase">
          {t("brand.subtitle")}
        </p>
        <h1 class="mt-3 text-3xl font-semibold text-pretty sm:text-4xl md:text-5xl">
          {t("churin.pageTitle")}
        </h1>
        <p class="mt-8 leading-relaxed text-pretty text-stone-600">{t("churin.deck")}</p>
        <p class="mt-8 leading-relaxed text-pretty">{t("churin.intro")}</p>
        <a
          href={bookHref}
          target="_blank"
          rel="noopener noreferrer"
          class="font-source-sans-3 bg-accent-500 text-accent-950 hover:bg-accent-400 mt-8 inline-flex min-h-11 items-center gap-2 px-5 text-sm font-medium tracking-widest uppercase"
          data-churin-intro-booking
        >
          <Whatsapp class="size-4 shrink-0" />
          {t("churin.bookCta")}
        </a>
      </div>
      <aside class="lg:col-span-4 lg:col-start-9 lg:self-start">
        <ul class="grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-1" data-churin-facts>
          {facts.map((item) => (
            <li class="min-w-0">
              <p class="text-2xl font-semibold text-stone-900">{item.value}</p>
              <p class="font-source-sans-3 mt-1 text-xs font-medium tracking-widest text-stone-500 uppercase">
                {item.label}
              </p>
            </li>
          ))}
        </ul>
      </aside>
    </div>

    <div class="relative order-1 aspect-2/1 lg:order-2 lg:max-h-[32rem]" data-churin-hero>
      <Image
        class="absolute inset-0 h-full w-full object-cover object-center"
        src={plaza}
        layout="full-width"
        loading="eager"
        fetchpriority="high"
        alt={t("churin.imageAlt")}
      />
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 py-8 md:px-8 md:py-16 lg:py-24">
    <div class="max-w-3xl">
      <h2 class="text-2xl font-semibold text-pretty md:text-3xl lg:text-4xl">
        {t("churin.centerTitle")}
      </h2>
      <p class="mt-6 leading-relaxed text-pretty">{t("churin.center")}</p>
      <h2
        id="desde-lima"
        class="scroll-offset mt-16 text-2xl font-semibold text-pretty md:text-3xl lg:text-4xl"
      >
        {t("churin.roadTitle")}
      </h2>
      <div class="mt-6 space-y-3 leading-relaxed text-pretty">
        <p>
          <strong class="font-semibold">{t("churin.roadCarLabel")}</strong> {t("churin.roadCar")}
        </p>
        <p>
          <strong class="font-semibold">{t("churin.roadBusLabel")}</strong> {t("churin.roadBus")}
        </p>
      </div>
      <p class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a
          href={mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center underline decoration-stone-400 underline-offset-4 hover:decoration-stone-900"
        >
          {t("location.cta")}
        </a>
        <a
          href={roomsHref}
          class="inline-flex min-h-11 items-center underline decoration-stone-400 underline-offset-4 hover:decoration-stone-900"
        >
          {t("churin.roomsCta")}
        </a>
      </p>
    </div>
  </div>
</article>

<section id="termas" class="bg-accent-100 text-accent-950 scroll-offset">
  <div class="mx-auto max-w-7xl px-4 pt-16 pb-10 md:px-8 md:pt-24 md:pb-16">
    <h2 class="text-2xl font-semibold text-pretty md:text-3xl lg:text-4xl">
      {t("churin.bathsTitle")}
    </h2>
    <p class="mt-6 max-w-2xl leading-relaxed text-pretty text-stone-600">{t("churin.bathsLead")}</p>
  </div>
  <div class="mx-auto max-w-7xl space-y-10 px-4 pb-16 md:space-y-16 md:px-8 md:pb-24">
    {pools.map((pool, index) => (
      <div id={pool.id} class="scroll-offset">
        <div class="grid gap-8 md:grid-cols-2 md:gap-12">
          <div
            class:list={[
              "relative aspect-4/3 overflow-hidden",
              index % 2 === 1 && "md:col-start-2 md:row-start-1",
            ]}
          >
            <Image
              class="absolute inset-0 h-full w-full object-cover object-center"
              src={pool.image}
              width={720}
              height={540}
              sizes="(min-width: 80rem) 36rem, (min-width: 48rem) 46vw, 100vw"
              layout="constrained"
              loading="lazy"
              alt={pool.alt}
            />
          </div>
          <div class="flex flex-col justify-end">
            <p class="font-source-sans-3 text-accent-700 text-xs font-medium tracking-widest uppercase">
              {pool.drive}
            </p>
            <h3 class="mt-4 text-2xl font-semibold text-pretty md:text-3xl" translate="no">
              {pool.name}
            </h3>
            <p class="mt-4 leading-relaxed text-pretty text-stone-600">{pool.body}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<BookingBand
  kicker={false}
  title={t("churin.booking.title")}
  body={`${t("brand.name")} · ${address}. ${t("churin.booking.body")}`}
  cta={t("churin.booking.cta")}
/>
