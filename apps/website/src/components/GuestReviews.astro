---
import { mapsUrl } from "@/lib/constants";
import { getLang, useTranslations } from "@/i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const translated = t("reviews.translated");

const verbatimGoogleReviews = [
  { name: "Raquel", quote: t("reviews.raquel") },
  { name: "VrV", quote: t("reviews.vrv") },
  { name: "Milton", quote: t("reviews.milton") },
];
---

<section class="bg-white">
  <div class="mx-auto max-w-7xl px-4 py-8 md:px-8 md:py-16 lg:py-24">
    <p class="font-source-sans-3 text-xs font-medium tracking-widest text-stone-900 uppercase">
      {t("reviews.label")}
    </p>
    <h2 class="text-accent-950 mt-3 text-2xl font-semibold text-pretty md:text-3xl lg:text-4xl">
      {t("reviews.title")}
    </h2>
    <p class="mt-4 max-w-[60ch] leading-relaxed text-pretty text-stone-600">{t("reviews.body")}</p>
    <div class="mt-8 grid grid-cols-1 divide-y divide-stone-200 md:mt-12 md:grid-cols-3 md:gap-10 md:divide-y-0 lg:gap-16">
      {verbatimGoogleReviews.map(({ name, quote }) => (
        <figure class="flex flex-col py-6 first:pt-0 last:pb-0 md:py-0">
          <span aria-hidden="true" class="text-accent-500 block h-8 text-6xl leading-none">
            &ldquo;
          </span>
          <blockquote class="mt-2 text-lg leading-relaxed text-pretty text-stone-800">
            <p>{quote}</p>
          </blockquote>
          {translated && <p class="font-source-sans-3 mt-3 text-sm text-stone-600">{translated}</p>}
          <figcaption class="font-source-sans-3 mt-4 text-xs font-medium tracking-widest text-stone-600 uppercase md:mt-auto md:pt-6">
            <span translate="no">{name}</span> · Google
            <span class="md:hidden"> · </span>
            <span class="md:block">{t("reviews.date")}</span>
          </figcaption>
        </figure>
      ))}
    </div>
    <a
      href={mapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="font-source-sans-3 hover:border-accent-500 hover:bg-accent-500 hover:text-accent-950 mt-8 flex min-h-11 w-full items-center justify-center border border-stone-900 px-5 text-sm font-medium tracking-widest text-stone-900 uppercase md:mt-12 md:inline-flex md:w-fit"
    >
      {t("reviews.cta")}
    </a>
  </div>
</section>
