---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLang, useTranslations } from "@/i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const homeHref = getRelativeLocaleUrl(lang);
const roomsHref = getRelativeLocaleUrl(lang, "habitaciones");
---

<section class="flex min-h-[calc(100dvh-110px)] items-center bg-stone-100">
  <div class="mx-auto w-full max-w-7xl px-4 py-8 md:px-8 md:py-16 lg:py-24">
    <div class="mx-auto w-full max-w-xl text-center">
      <p class="font-source-sans-3 text-accent-700 text-xs font-medium tracking-widest uppercase">
        404
      </p>
      <h1 class="mt-4 text-2xl font-semibold text-pretty text-stone-900 md:text-3xl lg:text-4xl">
        {t("notFound.title")}
      </h1>
      <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-pretty text-stone-600 sm:text-base">
        {t("notFound.body")}
      </p>
      <div class="mx-auto mt-8 flex max-w-xs items-center gap-3" aria-hidden="true">
        <span class="h-px flex-1 bg-stone-300"></span>
        <span class="bg-accent-700 size-1.5 shrink-0"></span>
        <span class="h-px flex-1 bg-stone-300"></span>
      </div>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href={homeHref}
          class="font-source-sans-3 bg-accent-500 text-accent-950 hover:bg-accent-400 inline-flex min-h-11 items-center px-5 text-sm font-medium tracking-widest uppercase"
        >
          {t("notFound.homeCta")}
        </a>
        <a
          href={roomsHref}
          class="font-source-sans-3 hover:border-accent-500 hover:bg-accent-500 hover:text-accent-950 inline-flex min-h-11 items-center border border-stone-900 px-5 text-sm font-medium tracking-widest text-stone-900 uppercase"
        >
          {t("hero.roomsCta")}
        </a>
      </div>
    </div>
  </div>
</section>
