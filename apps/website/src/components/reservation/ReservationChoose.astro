---
import { Image } from "astro:assets";
import Whatsapp from "@/icons/Whatsapp.svg";
import StaySearch from "@/components/StaySearch.astro";
import ReservationHelp from "@/components/reservation/ReservationHelp.astro";
import ReservationSteps from "@/components/reservation/ReservationSteps.astro";
import { ui } from "@/i18n/ui";
import { getLang, useTranslations } from "@/i18n/utils";
import { getWhatsAppLink } from "@/lib/constants";
import { reservationApiUrl } from "@/lib/reservation/api";
import { reviewStepHref } from "@/lib/reservation/links";
import { ratePlanCodes } from "@/lib/reservation/search";
import { rooms } from "@/lib/rooms";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const copy = {
  lang,
  apiBase: reservationApiUrl,
  reviewHref: reviewStepHref(lang),
  text: Object.fromEntries(
    (Object.keys(ui[lang]) as (keyof (typeof ui)[typeof lang])[])
      .filter((key) => key.startsWith("reservation."))
      .map((key) => [key, t(key)]),
  ),
  rooms: Object.fromEntries(
    rooms.map((room) => [
      room.id,
      { name: t(room.nameKey), pmsRoomTypeId: room.pmsRoomTypeId ?? null },
    ]),
  ),
};
const panel = "border border-stone-300 bg-white p-5 md:p-8";
const primary =
  "font-source-sans-3 bg-accent-500 text-accent-950 hover:bg-accent-400 inline-flex min-h-12 cursor-pointer items-center justify-center gap-2 px-6 text-sm font-semibold tracking-widest uppercase";
const secondary =
  "font-source-sans-3 inline-flex min-h-12 cursor-pointer items-center justify-center gap-2 border border-stone-900 px-6 text-sm font-semibold tracking-widest text-stone-900 uppercase hover:bg-stone-100";
---

<section class="bg-stone-100">
  <div class="mx-auto max-w-3xl px-4 py-8 md:px-8 md:py-16">
    <ReservationSteps current="choose" />
    <h1 class="mt-8 text-3xl font-semibold text-pretty text-stone-900 sm:text-4xl">
      {t("reservation.choose.title")}
    </h1>
    <reservation-choose class="block">
      <script
        type="application/json"
        is:inline
        data-copy
        set:html={JSON.stringify(copy).replace(/</g, "\\u003c")}
      />
      <div class="mt-6" data-search-form>
        <StaySearch layout="bar" submit={t("reservation.search.submit")} />
      </div>
      <p class="mt-6 text-stone-700" role="status" data-status>
        {t("reservation.choose.missing")}
      </p>
      <div class={`mt-6 ${panel}`} data-problem hidden>
        <h2 class="text-xl font-semibold text-stone-900" tabindex="-1" data-problem-title />
        <p class="mt-3 leading-relaxed text-stone-700" data-problem-body />
        <button type="button" class={`mt-6 ${primary}`} data-retry hidden>
          {t("reservation.choose.retry")}
        </button>
      </div>
      <div class="mt-6 border-l-4 border-amber-600 bg-white p-4 text-stone-800" data-notice hidden>
        <p class="font-semibold" data-notice-title />
        <ul class="mt-2 list-disc pl-5" data-notice-reasons />
      </div>
      <ul class="mt-6 flex flex-col gap-8" data-results hidden>
        {rooms.map((room) => (
          <li data-room={room.id} hidden>
            <article class={panel} aria-labelledby={`room-${room.id}-name`}>
              <div class="grid gap-5 sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
                <Image
                  class="aspect-video w-full object-cover sm:aspect-4/3"
                  src={room.gallery[0]!.src}
                  width={640}
                  height={480}
                  layout="constrained"
                  alt={t(room.gallery[0]!.altKey)}
                />
                <div>
                  <p
                    class="font-source-sans-3 text-accent-800 text-xs font-semibold tracking-widest uppercase"
                    data-preferred
                    hidden
                  >
                    {t("reservation.room.preferred")}
                  </p>
                  <h2 id={`room-${room.id}-name`} class="text-2xl font-semibold text-stone-900">
                    {t(room.nameKey)}
                  </h2>
                  <p class="mt-2 leading-relaxed text-stone-700">
                    {t(room.bedsKey)} · {t(room.areaKey)}
                    <span data-capacity hidden>
                      {" · "}
                      <span data-capacity-value />
                    </span>
                  </p>
                </div>
              </div>
              <p class="mt-5 font-semibold text-stone-900" data-room-note hidden />
              <a
                href={getWhatsAppLink(t(room.prefillKey))}
                target="_blank"
                rel="noopener noreferrer"
                class={`mt-4 ${secondary}`}
                data-room-contact
                hidden
              >
                <Whatsapp class="size-4 shrink-0" />
                {t("booking.cta")}
              </a>
              <ul class="mt-6 flex flex-col gap-3" data-rates hidden>
                {ratePlanCodes.map((plan) => (
                  <li
                    class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-4 gap-y-1 border border-stone-300 p-4 sm:grid-cols-[minmax(0,1fr)_auto_auto] sm:items-center"
                    data-plan={plan}
                    hidden
                  >
                    <h3 class="col-start-1 row-start-1 text-lg font-semibold text-stone-900">
                      {t(`reservation.plan.${plan}`)}
                    </h3>
                    <p
                      class="col-span-2 row-start-2 text-sm leading-relaxed text-stone-700 sm:col-span-1"
                      data-rate-terms
                    />
                    <div class="col-start-2 row-start-1 text-right sm:row-span-2">
                      <p class="text-lg font-semibold text-stone-900" data-amount="total" />
                      <p class="text-sm text-stone-600" data-rate-nights />
                    </div>
                    <a
                      class={`col-span-2 row-start-3 mt-3 sm:col-span-1 sm:col-start-3 sm:row-span-2 sm:row-start-1 sm:mt-0 ${primary}`}
                      aria-label={t("reservation.rate.bookLabel")
                        .replace("{room}", t(room.nameKey))
                        .replace("{plan}", t(`reservation.plan.${plan}`))}
                      data-book
                    >
                      {t("reservation.rate.book")}
                    </a>
                  </li>
                ))}
              </ul>
            </article>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-sm text-stone-600" data-taxes hidden />
    </reservation-choose>
    <ReservationHelp />
  </div>
</section>

<script>
  import { resumeSearch, storeSearch } from "@/lib/reservation/draft";
  import { dateElement, fill, fillNodes, formatList, formatMoney } from "@/lib/reservation/format";
  import {
    fetchOffers,
    type OfferSearchResult,
    type PlanOffer,
    type RoomTypeOffers,
  } from "@/lib/reservation/offers";
  import {
    nightsBetween,
    searchParams,
    staySearchEvent,
    type StaySearch,
  } from "@/lib/reservation/search";
  import type { Lang } from "@/i18n/utils";

  type Copy = {
    lang: Lang;
    apiBase: string;
    reviewHref: string;
    text: Record<string, string>;
    rooms: Record<string, { name: string; pmsRoomTypeId: string | null }>;
  };

  const backendProblems: Record<string, string> = {
    "online check-in must be after today": "reservation.problem.checkInTooSoon",
    "stay must be at least one night": "reservation.problem.checkOutBeforeCheckIn",
    "stay cannot be longer than 60 nights": "reservation.problem.tooManyNights",
    "invalid date": "reservation.problem.invalidDate",
  };

  const unavailableReasons = ["sold_out", "too_many_guests", "offline"] as const;

  class ReservationChoose extends HTMLElement {
    private copy!: Copy;
    private search!: StaySearch;
    private result: OfferSearchResult | null = null;
    private controller: AbortController | null = null;

    private text(key: string, values: Record<string, string | number> = {}) {
      return fill(this.copy.text[key] ?? key, values);
    }

    private el<T extends HTMLElement = HTMLElement>(selector: string, root: ParentNode = this) {
      return root.querySelector<T>(selector)!;
    }

    private money(cents: number) {
      return formatMoney(cents, this.result?.currency ?? "PEN");
    }

    private count(key: string, count: number) {
      return this.text(`${key}.${count === 1 ? "one" : "other"}`, { count });
    }

    connectedCallback() {
      this.copy = JSON.parse(this.el("[data-copy]").textContent ?? "{}") as Copy;
      this.el("[data-retry]").addEventListener("click", () => void this.load());
      this.addEventListener(staySearchEvent, (event) => {
        const { checkIn, checkOut, adults, children } = (event as CustomEvent<StaySearch>).detail;
        this.show({ ...this.search, checkIn, checkOut, adults, children, plan: null });
      });
      this.show(
        resumeSearch(new URLSearchParams(window.location.search), Object.keys(this.copy.rooms)),
      );
    }

    private show(search: StaySearch) {
      this.search = search;
      if (!search.checkIn || !search.checkOut) {
        this.reset(this.text("reservation.choose.missing"));
        return;
      }
      storeSearch(search);
      history.replaceState(
        history.state,
        "",
        `?${searchParams(search, { withChoice: false }).toString()}`,
      );
      void this.load();
    }

    private reset(status: string) {
      const message = this.el("[data-status]");
      message.textContent = status;
      message.classList.remove("sr-only");
      for (const selector of ["[data-problem]", "[data-notice]", "[data-results]", "[data-taxes]"])
        this.el(selector).hidden = true;
    }

    private showProblem(titleKey: string, body: string, retry: boolean) {
      this.reset("");
      this.el("[data-problem]").hidden = false;
      this.el("[data-problem-title]").textContent = this.text(titleKey);
      this.el("[data-problem-body]").textContent = body;
      this.el("[data-retry]").hidden = !retry;
      this.el("[data-problem-title]").focus();
    }

    private async load() {
      this.controller?.abort();
      this.controller = new AbortController();
      this.reset(this.text("reservation.choose.loading"));
      const outcome = await fetchOffers(
        this.copy.apiBase,
        this.search,
        this.controller.signal,
      ).catch(() => null);
      if (!outcome) return;
      if (outcome.kind === "throttled")
        return this.showProblem(
          "reservation.choose.throttled.title",
          this.text("reservation.choose.throttled.body"),
          true,
        );
      if (outcome.kind === "unavailable")
        return this.showProblem(
          "reservation.choose.unavailable.title",
          this.text("reservation.choose.unavailable.body"),
          true,
        );
      if (outcome.kind === "invalid")
        return this.showProblem(
          "reservation.choose.invalid.title",
          this.text(backendProblems[outcome.error] ?? "reservation.problem.invalidSearch"),
          false,
        );
      this.result = outcome.result;
      this.render();
    }

    private offersFor(pmsRoomTypeId: string | null): RoomTypeOffers | undefined {
      return pmsRoomTypeId
        ? this.result?.roomTypes.find((type) => type.id === pmsRoomTypeId)
        : undefined;
    }

    private render() {
      const list = this.el("[data-results]");
      const items = [...list.querySelectorAll<HTMLElement>("[data-room]")];
      const preferred = this.search.room;
      if (preferred) {
        const item = items.find((candidate) => candidate.dataset.room === preferred);
        if (item) list.prepend(item);
      }
      const states = items.map((item) =>
        this.renderRoom(item, item.dataset.room!, item.dataset.room === preferred),
      );
      list.hidden = false;
      const taxes = this.el("[data-taxes]");
      taxes.textContent = this.text("reservation.offer.taxes", { currency: this.result!.currency });
      taxes.hidden = !states.includes("available");
      const status = this.el("[data-status]");
      status.textContent = this.text("reservation.choose.loaded");
      status.classList.add("sr-only");

      const stateOf = new Map(items.map((item, index) => [item.dataset.room!, states[index]!]));
      if (!states.includes("available")) {
        this.showNotice(
          this.text("reservation.choose.noOffers.title"),
          unavailableReasons.flatMap((state) => {
            const names = Object.keys(this.copy.rooms)
              .filter((roomId) => stateOf.get(roomId) === state)
              .map((roomId) => this.copy.rooms[roomId]!.name);
            return names.length
              ? [
                  this.text(`reservation.choose.reason.${state}`, {
                    rooms: formatList(names, this.copy.lang),
                  }),
                ]
              : [];
          }),
        );
      } else if (preferred && stateOf.get(preferred) !== "available") {
        this.showNotice(
          this.text("reservation.room.preferredUnavailable", {
            room: this.copy.rooms[preferred]!.name,
          }),
          [],
        );
      }
    }

    private showNotice(title: string, reasons: string[]) {
      const notice = this.el("[data-notice]");
      this.el("[data-notice-title]", notice).textContent = title;
      this.el("[data-notice-reasons]", notice).replaceChildren(
        ...reasons.map((reason) =>
          Object.assign(document.createElement("li"), { textContent: reason }),
        ),
      );
      notice.hidden = false;
    }

    private renderRoom(item: HTMLElement, roomId: string, preferred: boolean) {
      const offers = this.offersFor(this.copy.rooms[roomId]!.pmsRoomTypeId);
      const state = offers?.availability ?? "offline";
      item.hidden = false;
      this.el("[data-preferred]", item).hidden = !preferred;
      const note = this.el("[data-room-note]", item);
      note.hidden = state === "available";
      note.textContent =
        state === "sold_out"
          ? this.text("reservation.room.soldOut")
          : state === "too_many_guests"
            ? this.text("reservation.room.tooManyGuests", {
                adults: offers!.maxAdults,
                children: offers!.maxChildren,
              })
            : state === "offline"
              ? this.text("reservation.room.offline")
              : "";
      this.el("[data-room-contact]", item).hidden = state !== "offline";
      this.el("[data-capacity]", item).hidden = !offers;
      if (offers)
        this.el("[data-capacity-value]", item).textContent = this.text(
          "reservation.room.capacityValue",
          {
            adults: offers.maxAdults,
            children: offers.maxChildren,
          },
        );
      this.el("[data-rates]", item).hidden = state !== "available";
      for (const rate of item.querySelectorAll<HTMLElement>("[data-plan]")) {
        const offer =
          state === "available"
            ? offers!.offers.find((candidate) => candidate.ratePlan === rate.dataset.plan)
            : undefined;
        rate.hidden = !offer;
        if (offer) this.renderOffer(rate, roomId, offer);
      }
      return state;
    }

    private renderOffer(rate: HTMLElement, roomId: string, offer: PlanOffer) {
      const nights = nightsBetween(this.search.checkIn, this.search.checkOut) ?? 0;
      this.el('[data-amount="total"]', rate).textContent = this.money(offer.totalCents);
      this.el("[data-rate-nights]", rate).textContent = this.text("reservation.rate.total", {
        nights: this.count("reservation.nights", nights),
      });
      this.el("[data-rate-terms]", rate).replaceChildren(...this.rateTerms(offer));
      this.el<HTMLAnchorElement>("[data-book]", rate).href =
        `${this.copy.reviewHref}?${searchParams({
          ...this.search,
          room: roomId as StaySearch["room"],
          plan: offer.ratePlan,
        }).toString()}`;
    }

    private rateTerms({ cancellation, savingCents }: PlanOffer) {
      const terms: (string | Node)[] =
        cancellation.freeCancellation === "available" && cancellation.freeUntil
          ? fillNodes(this.text("reservation.rate.freeUntil"), {
              date: dateElement(cancellation.freeUntil, this.copy.lang),
            })
          : [
              this.text(
                cancellation.freeCancellation === "ended"
                  ? "reservation.rate.freeEnded"
                  : "reservation.rate.noFree",
              ),
            ];
      if (savingCents <= 0) return terms;
      const saving = document.createElement("span");
      saving.className = "font-semibold text-green-800";
      saving.textContent = this.text("reservation.rate.saving", {
        amount: this.money(savingCents),
      });
      return [...terms, " · ", saving];
    }
  }
  customElements.define("reservation-choose", ReservationChoose);
</script>
