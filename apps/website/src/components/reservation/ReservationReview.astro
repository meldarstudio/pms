---
import { PUBLIC_CULQI_PUBLIC_KEY, PUBLIC_TURNSTILE_SITE_KEY } from "astro:env/client";
import { getImage } from "astro:assets";
import { ArrowLeftIcon, ArrowSquareOutIcon, XIcon } from "@phosphor-icons/react";
import ReservationHelp from "@/components/reservation/ReservationHelp.astro";
import { getWhatsAppLink } from "@/lib/constants";
import { BUSINESS_NAME } from "@/constants";
import {
  BookingSteps,
  bookingStepsKeys,
  type BookingStepsText,
} from "@/components/reservation/BookingSteps";
import { ui } from "@/i18n/ui";
import { getLang, useTranslations } from "@/i18n/utils";
import { roomsHref, summaryStepHref } from "@/lib/reservation/links";
import { reservationApiUrl } from "@/lib/reservation/api";
import { rooms } from "@/lib/rooms";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const cardPayments = Boolean(PUBLIC_CULQI_PUBLIC_KEY && PUBLIC_TURNSTILE_SITE_KEY);
const bothCheckoutsForPaymentsToggle = import.meta.env.DEV;
const showOnline = cardPayments || bothCheckoutsForPaymentsToggle;
const showOffline = !cardPayments || bothCheckoutsForPaymentsToggle;
const onlineOnly = "group-data-[payments=off]/review:hidden";
const offlineOnly = "group-data-[payments=on]/review:hidden";
const copy = {
  lang,
  apiBase: reservationApiUrl,
  payments: cardPayments
    ? {
        culqiPublicKey: PUBLIC_CULQI_PUBLIC_KEY!,
        turnstileSiteKey: PUBLIC_TURNSTILE_SITE_KEY!,
        title: BUSINESS_NAME,
      }
    : null,
  devPayments: bothCheckoutsForPaymentsToggle
    ? {
        culqiPublicKey: PUBLIC_CULQI_PUBLIC_KEY ?? "pk_test_placeholder_culqi_rejects",
        turnstileSiteKey: PUBLIC_TURNSTILE_SITE_KEY ?? "1x00000000000000000000AA",
        title: BUSINESS_NAME,
      }
    : null,
  chooseHref: roomsHref(lang),
  summaryHref: summaryStepHref(lang),
  text: Object.fromEntries(
    (Object.keys(ui[lang]) as (keyof (typeof ui)[typeof lang])[])
      .filter((key) => key.startsWith("reservation."))
      .map((key) => [key, t(key)]),
  ),
  rooms: Object.fromEntries(
    await Promise.all(
      rooms.map(async (room) => [
        room.id,
        {
          name: t(room.nameKey),
          beds: t(room.bedsKey),
          pmsRoomTypeId: room.pmsRoomTypeId ?? null,
          photo: {
            src: (await getImage({ src: room.gallery[0]!.src, width: 160, format: "webp" })).src,
            alt: t(room.gallery[0]!.altKey),
          },
        },
      ]),
    ),
  ),
};
const panel = "border border-stone-300 bg-white p-5 md:p-8";
const primary =
  "font-source-sans-3 bg-accent-500 text-accent-950 hover:bg-accent-400 inline-flex min-h-12 cursor-pointer items-center justify-center gap-2 px-6 text-sm font-semibold tracking-widest uppercase";
const secondary =
  "font-source-sans-3 inline-flex min-h-12 cursor-pointer items-center justify-center gap-2 border border-stone-900 px-6 text-sm font-semibold tracking-widest text-stone-900 uppercase hover:bg-stone-100";
const quietLink =
  "font-source-sans-3 text-accent-800 inline-flex min-h-11 items-center text-sm font-medium underline-offset-4 hover:underline";
const eyebrow = "font-source-sans-3 text-xs font-medium tracking-widest text-stone-600 uppercase";
const card = "p-6 md:p-8";
const cardTitle = "text-[1.375rem] leading-snug font-semibold text-stone-900";
const headline = "flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1";
const row = "flex items-baseline justify-between gap-4 py-0.5";
const field =
  "mt-2 block min-h-12 w-full border border-stone-400 bg-white px-3 text-base text-stone-900 aria-invalid:border-red-700";
const label = "font-source-sans-3 text-sm font-semibold text-stone-800";
const error = "mt-2 text-sm font-medium text-red-800";
const [agreeBefore, agreeAfter] = t("reservation.review.agree").split("{terms}");
const contactFields = [
  {
    id: "fullName",
    type: "text",
    autocomplete: "name",
    inputmode: "text",
    autocapitalize: "words",
    spellcheck: "false",
  },
  {
    id: "email",
    type: "email",
    autocomplete: "email",
    inputmode: "email",
    autocapitalize: "off",
    spellcheck: "false",
  },
  {
    id: "phone",
    type: "tel",
    autocomplete: "tel",
    inputmode: "tel",
    autocapitalize: "off",
    spellcheck: "false",
  },
] as const;
---

<section class="bg-stone-100">
  <div class="mx-auto max-w-7xl px-4 py-8 md:px-8 md:py-12">
    <BookingSteps
      current="review"
      text={Object.fromEntries(bookingStepsKeys.map((key) => [key, t(key)])) as BookingStepsText}
    />
    <reservation-review
      class="group/review block lg:mt-6"
      data-payments={cardPayments ? "on" : "off"}
    >
      <script
        type="application/json"
        is:inline
        data-copy
        set:html={JSON.stringify(copy).replace(/</g, "\\u003c")}
      />
      <a
        href={roomsHref(lang)}
        class="font-source-sans-3 hover:text-accent-800 inline-flex min-h-11 items-center gap-2 text-xs font-medium tracking-widest text-stone-900 uppercase"
        data-back-to-rates
      >
        <ArrowLeftIcon aria-hidden="true" className="size-4 shrink-0" />
        {t("reservation.review.backToRates")}
      </a>
      <h1 class="mt-3 text-2xl font-semibold text-pretty text-stone-900 md:text-3xl">
        {t("reservation.review.title")}
      </h1>
      {showOnline && (
        <p class={`mt-2 max-w-xl leading-relaxed text-stone-600 ${onlineOnly}`}>
          {t("reservation.review.lead")}
        </p>
      )}
      {showOffline && (
        <p class={`mt-2 max-w-xl leading-relaxed text-stone-600 ${offlineOnly}`}>
          {t("reservation.review.unavailableLead")}
        </p>
      )}
      <p class="mt-6 text-stone-700 empty:hidden" role="status" data-status>
        {t("reservation.review.loading")}
      </p>
      <div class={`mt-6 ${panel}`} data-problem hidden>
        <h2 class="text-xl font-semibold text-stone-900" tabindex="-1" data-problem-title />
        <p class="mt-3 leading-relaxed text-stone-700" data-problem-body />
        <div class="mt-6 flex flex-wrap gap-3">
          <button type="button" class={primary} data-retry hidden>
            {t("reservation.choose.retry")}
          </button>
          <a href={roomsHref(lang)} class={secondary} data-problem-back>
            {t("reservation.review.backToRooms")}
          </a>
        </div>
      </div>
      <div
        class="mt-6 grid items-start gap-6 [overflow-wrap:anywhere] lg:grid-cols-[minmax(0,1fr)_24rem] lg:gap-12"
        data-review
        hidden
      >
        <aside
          class="min-w-0 border border-stone-200 bg-white p-5 md:p-6 lg:sticky lg:top-36 lg:col-start-2 lg:row-start-1"
          aria-labelledby="review-stay"
        >
          <div class="flex items-start gap-4">
            <img
              class="size-20 shrink-0 object-cover object-center"
              width="80"
              height="80"
              data-room-photo
              alt=""
            />
            <div class="min-w-0">
              <h2 id="review-stay" class={eyebrow}>
                {t("reservation.review.stay")}
              </h2>
              <p class="mt-2 text-xl font-semibold text-pretty text-stone-900" data-stay="room" />
              <p class="mt-1 text-sm text-stone-600" data-stay="room-details" />
            </div>
          </div>
          <p class="mt-4 text-sm leading-relaxed text-stone-700 lg:hidden" data-stay="compact" />
          <dl class="mt-5 border-t border-stone-200 pt-5">
            <div class={headline}>
              <dt class="text-sm font-medium text-stone-900">{t("reservation.offer.total")}</dt>
              <dd
                class="text-2xl font-semibold whitespace-nowrap text-stone-900"
                data-amount="total"
              />
            </div>
          </dl>
          <p class="mt-1 text-sm text-stone-600" data-taxes />
          <button
            type="button"
            class={`${quietLink} mt-2 w-full justify-between lg:hidden`}
            aria-expanded="false"
            aria-controls="review-details"
            data-summary-toggle
          >
            <span data-summary-toggle-label>{t("reservation.review.showDetails")}</span>
            <span aria-hidden="true" data-summary-toggle-icon>
              +
            </span>
          </button>
          <div id="review-details" class="hidden lg:block">
            <div class="mt-5 border-t border-stone-200 pt-5 text-sm">
              <dl class="grid grid-cols-2 gap-4">
                <div>
                  <dt class="text-stone-600">{t("reservation.review.checkIn")}</dt>
                  <dd class="mt-1 font-medium text-stone-900">
                    <time data-stay="checkIn" />
                  </dd>
                </div>
                <div>
                  <dt class="text-stone-600">{t("reservation.review.checkOut")}</dt>
                  <dd class="mt-1 font-medium text-stone-900">
                    <time data-stay="checkOut" />
                  </dd>
                </div>
              </dl>
              <p class="mt-2 text-stone-600" data-stay="nights" />
              <dl class="mt-4 grid grid-cols-2 gap-4">
                <div>
                  <dt class="text-stone-600">{t("reservation.review.guests")}</dt>
                  <dd class="mt-1 font-medium text-stone-900" data-stay="guests" />
                </div>
                <div>
                  <dt class="text-stone-600">{t("reservation.review.plan")}</dt>
                  <dd class="mt-1 font-medium text-stone-900" data-stay="plan" />
                </div>
              </dl>
            </div>
            <div class="mt-5 flex flex-wrap gap-x-4 border-t border-stone-200 pt-2">
              <a href={roomsHref(lang)} class={quietLink} data-back-to-rates>
                {t("reservation.review.changeRate")}
              </a>
              <a href={roomsHref(lang)} class={quietLink} data-change-choice>
                {t("reservation.review.changeChoice")}
              </a>
            </div>
          </div>
        </aside>
        <div
          class="min-w-0 border border-stone-200 bg-white lg:col-start-1 lg:row-start-1"
          data-workflow
        >
          {showOffline && (
            <section
              class={`${card} ${offlineOnly}`}
              aria-labelledby="review-whatsapp"
              data-whatsapp
            >
              <h2 id="review-whatsapp" class={cardTitle}>
                {t("reservation.review.whatsapp.title")}
              </h2>
              <p class="mt-4 leading-relaxed text-stone-700">
                {t("reservation.review.whatsapp.body")}
              </p>
              <a
                href={getWhatsAppLink(t("whatsapp.prefill"))}
                target="_blank"
                rel="noopener noreferrer"
                class={`mt-6 w-full ${primary}`}
                data-whatsapp-link
              >
                {t("reservation.review.whatsapp.button")}
                <span class="sr-only">({t("reservation.review.whatsapp.newTab")})</span>
                <ArrowSquareOutIcon aria-hidden="true" className="size-4.5 shrink-0" />
              </a>
              <p class="mt-4 text-sm text-stone-600">{t("reservation.review.whatsapp.note")}</p>
            </section>
          )}
          <form
            class="divide-y divide-stone-200"
            novalidate
            aria-labelledby="review-contact review-payment"
            data-contact-form
            hidden={!cardPayments}
          >
            <section class={card} aria-labelledby="review-contact">
              <h2 id="review-contact" class={cardTitle}>
                {t("reservation.review.contact")}
              </h2>
              <p class="mt-2 leading-relaxed text-stone-600">
                {t("reservation.review.contactLead")}
              </p>
              <div class="mt-6 flex flex-col gap-5">
                {contactFields.map((input) => (
                  <div>
                    <label for={input.id} class={label}>
                      {t(`reservation.review.${input.id}`)}
                    </label>
                    {input.id === "phone" && (
                      <p id="phone-hint" class="mt-1 text-sm text-stone-600">
                        {t("reservation.review.phoneHint")}
                      </p>
                    )}
                    <input
                      id={input.id}
                      name={input.id}
                      type={input.type}
                      autocomplete={input.autocomplete}
                      inputmode={input.inputmode}
                      autocapitalize={input.autocapitalize}
                      spellcheck={input.spellcheck}
                      required
                      maxlength={input.id === "phone" ? 40 : 200}
                      class={field}
                      aria-describedby={
                        input.id === "phone" ? "phone-hint phone-error" : `${input.id}-error`
                      }
                    />
                    <p id={`${input.id}-error`} class={error} hidden />
                  </div>
                ))}
              </div>
            </section>
            <section class={card} aria-labelledby="review-payment">
              <h2 id="review-payment" class={cardTitle}>
                {t("reservation.review.payment")}
              </h2>
              <p
                class="mt-4 border-l-4 border-amber-600 bg-amber-50 p-4 font-semibold text-stone-900"
                tabindex="-1"
                data-changed
                hidden
              >
                {t("reservation.review.changed")}
              </p>
              <dl class="mt-4 bg-stone-100 px-4 py-3">
                <div class={headline}>
                  <dt class="font-medium text-stone-900">{t("reservation.review.dueNow")}</dt>
                  <dd
                    class="text-2xl font-semibold whitespace-nowrap text-stone-900"
                    data-amount="now"
                  />
                </div>
                <div class={`${row} text-sm`} data-balance>
                  <dt class="text-stone-600">{t("reservation.review.balance")}</dt>
                  <dd class="text-stone-900" data-amount="remaining" />
                </div>
              </dl>
              <p class="mt-4 text-sm leading-relaxed text-stone-700" data-cancellation />
              <div class="mt-5 flex items-start gap-3">
                <input
                  id="agree"
                  name="agree"
                  type="checkbox"
                  required
                  class="accent-accent-700 mt-0.5 size-6 shrink-0"
                  aria-describedby="agree-error"
                />
                <label for="agree" class="cursor-pointer leading-relaxed text-stone-900">
                  {agreeBefore}
                  <a
                    href="#review-terms"
                    class="text-accent-800 decoration-accent-800/40 hover:decoration-accent-800 font-medium underline underline-offset-4"
                    aria-haspopup="dialog"
                    data-open-terms
                  >
                    {t("reservation.review.termsLink")}
                  </a>
                  {agreeAfter}
                </label>
              </div>
              <p id="agree-error" class={error} hidden />
              <p class="mt-5 font-medium text-red-800 empty:mt-0" role="alert" data-form-error />
              <div data-pay-action>
                <div
                  class="mt-5 min-h-16"
                  role="group"
                  aria-label={t("reservation.pay.security")}
                  data-security-check
                />
                <button type="submit" class={`mt-4 w-full ${primary}`} data-pay-button />
                <p class="mt-3 text-center text-sm text-stone-600">
                  {t("reservation.pay.provider")}
                </p>
              </div>
            </section>
          </form>
          <section
            class={`${card} border-stone-200 [[data-contact-form]:not([hidden])+&]:border-t`}
            aria-labelledby="review-outcome-title"
            data-outcome
            hidden
          >
            <div class="border-l-4 bg-stone-50 p-4" data-outcome-box>
              <h2
                id="review-outcome-title"
                class="text-xl font-semibold text-stone-900"
                tabindex="-1"
                data-outcome-title
              />
              <p class="mt-2 leading-relaxed text-stone-700" data-outcome-body />
              <dl class="mt-4 divide-y divide-stone-200" data-outcome-amounts />
              <div class="mt-4 flex flex-wrap gap-3">
                <button type="button" class={primary} data-outcome-retry hidden>
                  {t("reservation.outcome.retry")}
                </button>
                <button type="button" class={secondary} data-outcome-bank hidden>
                  {t("reservation.outcome.verifyBank")}
                </button>
                <button type="button" class={secondary} data-outcome-check hidden>
                  {t("reservation.outcome.check")}
                </button>
              </div>
              <div class="mt-4 border border-stone-300 bg-white p-4" data-access hidden>
                <p class="leading-relaxed text-stone-700">{t("reservation.summary.possession")}</p>
                <p class="mt-2 leading-relaxed text-stone-700">{t("reservation.summary.staff")}</p>
                <button type="button" class={`mt-4 ${secondary}`} data-access-copy>
                  {t("reservation.summary.copy")}
                </button>
                <p class="mt-2 font-medium text-stone-900" role="status" data-access-copied hidden>
                  {t("reservation.summary.copied")}
                </p>
              </div>
            </div>
          </section>
        </div>
      </div>
      <dialog
        id="review-terms"
        class="m-auto max-h-[calc(100dvh-2rem)] w-[min(36rem,calc(100vw-2rem))] overflow-y-auto bg-white p-0 text-stone-900 backdrop:bg-stone-950/60"
        aria-labelledby="review-terms-title"
        data-terms
      >
        <div class="sticky top-0 flex items-center justify-between gap-4 border-b border-stone-200 bg-white py-2 pr-2 pl-6">
          <h2 id="review-terms-title" class={cardTitle}>
            {t("reservation.review.terms")}
          </h2>
          <button
            type="button"
            class="inline-flex size-11 shrink-0 cursor-pointer items-center justify-center text-stone-700 hover:bg-stone-100 hover:text-stone-900"
            data-close-terms
          >
            <XIcon aria-hidden="true" className="size-5" />
            <span class="sr-only">{t("reservation.review.closeTerms")}</span>
          </button>
        </div>
        <div class="px-6 pt-5 pb-6">
          <h3 class="font-semibold text-stone-900">{t("reservation.review.nightly")}</h3>
          <ul class="mt-2 divide-y divide-stone-200 text-sm text-stone-800" data-nightly />
          <div class="mt-5 flex flex-col gap-3 text-sm leading-relaxed text-stone-700">
            <p data-schedule />
            <p data-terms-cancellation />
            <p>{t("reservation.cancel.settlement")}</p>
            <p>{t("reservation.review.lifecycle")}</p>
          </div>
        </div>
      </dialog>
    </reservation-review>
    <ReservationHelp />
  </div>
</section>

<script>
  import type { Lang } from "@/i18n/utils";
  import {
    acceptQuote,
    offerKey,
    quoteStillValid,
    readCheckout,
    refreshQuote,
    selectionKey,
    startCheckout,
    type BookingContact,
    type CheckoutOutcome,
    type CheckoutSelection,
    type CheckoutView,
  } from "@/lib/reservation/checkout";
  import {
    clearCardSource,
    contactKey,
    storeCard,
    storeCheckout,
    storeConfirmedReservation,
    storeContact,
    storedCard,
    storedCheckout,
    storedContact,
  } from "@/lib/reservation/draft";
  import { getWhatsAppLink } from "@/lib/constants";
  import { fill, formatDate, formatMoney } from "@/lib/reservation/format";
  import {
    allowsNewPayment,
    continuePayment,
    readPayment,
    startPayment,
    type GuestPayment,
    type PaymentOutcome,
  } from "@/lib/reservation/payment";
  import {
    deviceFingerprint,
    openBankAuthentication,
    openCardForm,
    renderSecurityCheck,
    type AuthenticationParameters,
    type SecurityCheck,
  } from "@/lib/reservation/providers";
  import { readSearch, searchParams, type StaySearch } from "@/lib/reservation/search";
  import { readCheckoutAccess, summaryLink } from "@/lib/reservation/summary";
  import { cancellationNodes } from "@/lib/reservation/terms";

  type Copy = {
    lang: Lang;
    apiBase: string;
    payments: Payments | null;
    devPayments: Payments | null;
    chooseHref: string;
    summaryHref: string;
    text: Record<string, string>;
    rooms: Record<
      string,
      {
        name: string;
        beds: string;
        pmsRoomTypeId: string | null;
        photo: { src: string; alt: string };
      }
    >;
  };

  type Payments = { culqiPublicKey: string; turnstileSiteKey: string; title: string };
  type Ready = Extract<CheckoutOutcome, { kind: "ready" }>;
  type Problem = Exclude<CheckoutOutcome, Ready> | { kind: "missing" };

  const contactFields = ["fullName", "email", "phone"] as const;
  type ContactField = (typeof contactFields)[number];

  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  const problemCopy: Record<Problem["kind"], { title: string; body: string; retry: boolean }> = {
    missing: {
      title: "reservation.review.missing.title",
      body: "reservation.review.missing.body",
      retry: false,
    },
    sold_out: {
      title: "reservation.review.soldOut.title",
      body: "reservation.review.soldOut.body",
      retry: false,
    },
    invalid: {
      title: "reservation.review.invalid.title",
      body: "reservation.problem.invalidSearch",
      retry: false,
    },
    throttled: {
      title: "reservation.review.throttled.title",
      body: "reservation.review.throttled.body",
      retry: true,
    },
    limited: {
      title: "reservation.review.limited.title",
      body: "reservation.review.limited.body",
      retry: true,
    },
    unavailable: {
      title: "reservation.review.unavailable.title",
      body: "reservation.review.unavailable.body",
      retry: true,
    },
    expired: {
      title: "reservation.review.unavailable.title",
      body: "reservation.review.unavailable.body",
      retry: true,
    },
    replaced: {
      title: "reservation.review.unavailable.title",
      body: "reservation.review.unavailable.body",
      retry: true,
    },
    denied: {
      title: "reservation.review.unavailable.title",
      body: "reservation.review.unavailable.body",
      retry: true,
    },
    has_payment: {
      title: "reservation.review.unavailable.title",
      body: "reservation.review.unavailable.body",
      retry: true,
    },
  };

  const payErrorCopy: Partial<Record<PaymentOutcome["kind"], string>> = {
    paused: "reservation.pay.error.paused",
    throttled: "reservation.pay.error.throttled",
    security_failed: "reservation.pay.error.securityFailed",
    security_unavailable: "reservation.pay.error.securityUnavailable",
    unavailable: "reservation.pay.error.unavailable",
  };

  const PAYMENT_POLL_MS = 5_000;
  const VERIFYING: readonly GuestPayment["state"][] = ["processing", "paid_awaiting_reservation"];

  const outcomeTone: Record<GuestPayment["state"], string> = {
    declined: "border-red-700",
    submitted: "border-amber-600",
    authentication_required: "border-amber-600",
    processing: "border-amber-600",
    paid_awaiting_reservation: "border-amber-600",
    unfulfilled: "border-red-700",
    confirmed: "border-accent-700",
    reservation_changed: "border-amber-600",
  };

  const formErrorCopy: Partial<Record<Problem["kind"], string>> = {
    invalid: "reservation.review.error.invalid",
    throttled: "reservation.review.error.throttled",
    unavailable: "reservation.review.error.unavailable",
  };

  const backendProblems: Record<string, string> = {
    "online check-in must be after today": "reservation.problem.checkInTooSoon",
    "too many guests for this room type": "reservation.review.problem.tooManyGuests",
    "room type not found": "reservation.room.offline",
    "stay must be at least one night": "reservation.problem.checkOutBeforeCheckIn",
    "stay cannot be longer than 60 nights": "reservation.problem.tooManyNights",
    "invalid date": "reservation.problem.invalidDate",
  };

  const contactProblems: Record<string, [ContactField, string]> = {
    "full name is required": ["fullName", "reservation.review.error.fullName"],
    "email is required": ["email", "reservation.review.error.email"],
    "invalid email": ["email", "reservation.review.error.email"],
    "phone is required": ["phone", "reservation.review.error.phone"],
    "invalid phone number": ["phone", "reservation.review.error.phoneInvalid"],
    "phone number is too short": ["phone", "reservation.review.error.phoneInvalid"],
    "phone number is too long": ["phone", "reservation.review.error.phoneInvalid"],
    "phone extensions are not supported": ["phone", "reservation.review.error.phoneInvalid"],
  };

  function previewPayments(host: HTMLElement, copy: Copy) {
    const url = new URL(location.href);
    const mode = url.searchParams.get("payments");
    if (mode === "on") copy.payments = copy.devPayments;
    if (mode === "off") copy.payments = null;
    host.dataset.payments = copy.payments ? "on" : "off";
    url.searchParams.set("payments", copy.payments ? "off" : "on");
    const toggle = document.createElement("a");
    toggle.href = url.href;
    toggle.className =
      "font-source-sans-3 fixed bottom-4 left-4 z-90 inline-flex min-h-11 items-center bg-stone-900 px-4 text-sm font-medium text-white shadow-lg hover:bg-stone-700";
    toggle.textContent = `Dev · ${copy.lang === "en" ? "Online payments" : "Pagos en línea"}: ${copy.payments ? "ON" : "OFF"} ⇄`;
    document.body.append(toggle);
  }

  class ReservationReview extends HTMLElement {
    private copy!: Copy;
    private search!: StaySearch;
    private selection!: CheckoutSelection;
    private key = "";
    private token = "";
    private view: CheckoutView | null = null;
    private payment: GuestPayment | null = null;
    private paying = false;
    private openedBankFor: string | null = null;
    private securityCheck: Promise<SecurityCheck | null> | null = null;
    private poll: ReturnType<typeof setTimeout> | undefined;
    private accessToken: string | null = null;
    private accessRequest = 0;

    private text(key: string, values: Record<string, string | number> = {}) {
      return fill(this.copy.text[key] ?? key, values);
    }

    private el<T extends HTMLElement = HTMLElement>(selector: string, root: ParentNode = this) {
      return root.querySelector<T>(selector)!;
    }

    private input(id: ContactField | "agree") {
      return this.el<HTMLInputElement>(`#${id}`);
    }

    private money(cents: number) {
      return formatMoney(cents, this.view?.currency ?? "PEN");
    }

    private count(key: string, count: number) {
      return this.text(`${key}.${count === 1 ? "one" : "other"}`, { count });
    }

    private contact(): BookingContact {
      return {
        fullName: this.input("fullName").value.trim(),
        email: this.input("email").value.trim(),
        phone: this.input("phone").value.trim(),
      };
    }

    private stored() {
      return storedCheckout(this.key);
    }

    connectedCallback() {
      this.copy = JSON.parse(this.el("[data-copy]").textContent ?? "{}") as Copy;
      if (import.meta.env.DEV) previewPayments(this, this.copy);
      this.search = readSearch(
        new URLSearchParams(window.location.search),
        Object.keys(this.copy.rooms),
      );
      const choiceHref = `${this.copy.chooseHref}?${searchParams(this.search, { withChoice: false }).toString()}`;
      for (const anchor of this.querySelectorAll<HTMLAnchorElement>(
        "[data-change-choice], [data-problem-back]",
      ))
        anchor.href = choiceHref;
      for (const anchor of this.querySelectorAll<HTMLAnchorElement>("[data-back-to-rates]"))
        anchor.href = `${this.copy.chooseHref}?${searchParams(this.search).toString()}`;

      this.el("[data-summary-toggle]").addEventListener("click", () => {
        this.expandSummary(
          this.el("[data-summary-toggle]").getAttribute("aria-expanded") !== "true",
        );
      });
      const terms = this.el<HTMLDialogElement>("[data-terms]");
      this.el("[data-open-terms]").addEventListener("click", (event) => {
        event.preventDefault();
        terms.showModal();
      });
      this.el("[data-close-terms]").addEventListener("click", () => terms.close());
      terms.addEventListener("click", (event) => {
        if (event.target === terms) terms.close();
      });

      this.restoreDraft();
      window.addEventListener("pageshow", (event) => {
        this.restoreDraft();
        if (event.persisted && this.key) void this.load();
        else this.showCheckout();
      });
      window.addEventListener("online", () => {
        if (this.awaitingStatus()) void this.syncPayment();
      });
      for (const id of contactFields) {
        this.input(id).addEventListener("input", () => {
          storeContact({
            fullName: this.input("fullName").value,
            email: this.input("email").value,
            phone: this.input("phone").value,
          });
          this.showFieldError(id, "");
          this.showCheckout();
        });
      }
      this.input("agree").addEventListener("change", () => {
        this.rememberAgreement();
        this.showFieldError("agree", "");
        this.showCheckout();
      });
      this.el("[data-retry]").addEventListener("click", () => void this.load());
      this.el("[data-outcome-retry]").addEventListener("click", () => this.payAgain());
      this.el("[data-outcome-bank]").addEventListener("click", () => void this.openBank());
      this.el("[data-outcome-check]").addEventListener("click", () => void this.syncPayment(true));
      this.el("[data-access-copy]").addEventListener("click", () => void this.copyAccessLink());
      this.el<HTMLFormElement>("[data-contact-form]").addEventListener("submit", (event) => {
        event.preventDefault();
        void this.pay();
      });

      const { room, plan, checkIn, checkOut } = this.search;
      const roomTypeId = room ? this.copy.rooms[room]?.pmsRoomTypeId : null;
      if (!room || !plan || !checkIn || !checkOut || !roomTypeId)
        return this.showProblem({ kind: "missing" });
      this.selection = {
        roomTypeId,
        checkIn,
        checkOut,
        adults: this.search.adults,
        children: this.search.children,
        ratePlan: plan,
      };
      this.key = selectionKey(this.selection);
      void this.load();
    }

    private restoreDraft() {
      const draft = storedContact();
      for (const id of contactFields) this.input(id).value = draft[id];
      this.input("agree").checked = Boolean(
        this.view && this.stored()?.agreedOffer === offerKey(this.view),
      );
    }

    private expandSummary(expanded: boolean) {
      this.el("[data-summary-toggle]").setAttribute("aria-expanded", String(expanded));
      this.el("#review-details").classList.toggle("hidden", !expanded);
      this.el('[data-stay="compact"]').classList.toggle("hidden", expanded);
      this.el("[data-summary-toggle-label]").textContent = this.text(
        expanded ? "reservation.review.hideDetails" : "reservation.review.showDetails",
      );
      this.el("[data-summary-toggle-icon]").textContent = expanded ? "−" : "+";
    }

    private async load() {
      this.el("[data-problem]").hidden = true;
      this.el("[data-status]").classList.remove("sr-only");
      this.el("[data-status]").textContent = this.text("reservation.review.loading");
      const outcome = await this.currentQuote();
      if (outcome.kind !== "ready") return this.showProblem(outcome);
      this.ready(outcome);
      await this.syncPayment();
    }

    private async currentQuote(): Promise<CheckoutOutcome> {
      const stored = this.stored();
      if (stored?.token) {
        const outcome = await readCheckout(this.copy.apiBase, stored.token);
        if (outcome.kind !== "denied") return outcome;
      }
      return startCheckout(this.copy.apiBase, this.selection, this.copy.lang);
    }

    private ready(outcome: Ready) {
      const previous = this.stored();
      const offer = offerKey(outcome.view);
      const agreed = previous?.agreedOffer === offer;
      this.token = outcome.token;
      this.view = outcome.view;
      storeCheckout(this.key, {
        token: outcome.token,
        agreedOffer: agreed ? offer : null,
        accepted: previous?.token === outcome.token ? previous.accepted : null,
        submitted: previous?.token === outcome.token ? (previous.submitted ?? null) : null,
      });
      this.input("agree").checked = agreed;
      this.el("[data-changed]").hidden = !previous?.agreedOffer || agreed;
      this.render(outcome.view);
      this.el("[data-review]").hidden = false;
      this.el("[data-status]").classList.add("sr-only");
      this.el("[data-status]").textContent = this.text("reservation.review.loaded");
      this.showCheckout();
    }

    private render(view: CheckoutView) {
      const { quote } = view;
      const set = (selector: string, value: string) => {
        this.el(selector).textContent = value;
      };
      const room = this.copy.rooms[this.search.room!]!;
      set('[data-stay="room"]', room.name);
      set('[data-stay="room-details"]', room.beds);
      const photo = this.el<HTMLImageElement>("[data-room-photo]");
      photo.src = room.photo.src;
      photo.alt = room.photo.alt;
      const nights = this.count("reservation.nights", view.nights);
      set(
        '[data-stay="compact"]',
        `${formatDate(view.checkIn, this.copy.lang, { includeWeekday: false })} – ${formatDate(view.checkOut, this.copy.lang, { includeWeekday: false })} · ${nights}`,
      );
      for (const date of ["checkIn", "checkOut"] as const) {
        const time = this.el<HTMLTimeElement>(`[data-stay="${date}"]`);
        time.dateTime = view[date];
        time.textContent = formatDate(view[date], this.copy.lang);
      }
      set('[data-stay="nights"]', nights);
      const adults = this.count("reservation.adults", view.adults);
      const guests = view.children
        ? `${adults}, ${this.count("reservation.children", view.children)}`
        : adults;
      set('[data-stay="guests"]', guests);
      const plan = this.text(`reservation.plan.${view.ratePlan}`);
      set('[data-stay="plan"]', plan);
      for (const total of this.querySelectorAll('[data-amount="total"]'))
        total.textContent = this.money(quote.totalCents);
      set("[data-taxes]", this.text("reservation.offer.taxes", { currency: view.currency }));
      if (!this.copy.payments) {
        this.el<HTMLAnchorElement>("[data-whatsapp-link]").href = getWhatsAppLink(
          this.text("reservation.review.whatsapp.message", {
            room: room.name,
            checkIn: formatDate(view.checkIn, this.copy.lang),
            checkOut: formatDate(view.checkOut, this.copy.lang),
            guests,
            plan,
            total: this.money(quote.totalCents),
          }),
        );
        return;
      }
      set('[data-amount="now"]', this.money(quote.requiredInitialPaymentCents));
      set(
        "[data-pay-button]",
        this.text("reservation.pay.button", {
          amount: this.money(quote.requiredInitialPaymentCents),
        }),
      );
      set('[data-amount="remaining"]', this.money(quote.remainingScheduledCents));
      this.el("[data-balance]").hidden = quote.remainingScheduledCents === 0;
      set(
        "[data-schedule]",
        this.text(`reservation.review.schedule.${view.ratePlan}`, {
          now: this.money(quote.requiredInitialPaymentCents),
          remaining: this.money(quote.remainingScheduledCents),
        }),
      );
      const cancellation = () =>
        cancellationNodes(quote.cancellation, {
          text: (key, values) => this.text(key, values),
          amount: this.money(quote.cancellation.chargeCents),
          lang: this.copy.lang,
        });
      this.el("[data-cancellation]").replaceChildren(...cancellation());
      this.el("[data-terms-cancellation]").replaceChildren(...cancellation());
      this.el("[data-nightly]").replaceChildren(
        ...quote.nights.map((night) => {
          const item = document.createElement("li");
          item.className = "flex justify-between gap-4 py-2";
          const date = document.createElement("time");
          date.dateTime = night.date;
          date.textContent = formatDate(night.date, this.copy.lang);
          const price = document.createElement("span");
          price.textContent = this.money(night.priceCents);
          item.append(date, price);
          return item;
        }),
      );
    }

    private rememberAgreement() {
      const stored = this.stored();
      if (!stored || !this.view) return;
      storeCheckout(this.key, {
        ...stored,
        agreedOffer: this.input("agree").checked ? offerKey(this.view) : null,
      });
    }

    private isAccepted() {
      const view = this.view;
      const accepted = this.stored()?.accepted;
      return Boolean(
        view &&
        view.acceptance?.quoteId === view.quote.id &&
        accepted?.quoteId === view.quote.id &&
        accepted.contact === contactKey(this.contact()) &&
        this.input("agree").checked,
      );
    }

    private serverAccepted(view: CheckoutView) {
      return quoteStillValid(view) && view.acceptance?.quoteId === view.quote.id;
    }

    private showCheckout() {
      const locked = !allowsNewPayment(this.payment);
      this.querySelector("[data-whatsapp]")?.toggleAttribute("hidden", Boolean(this.payment));
      const form = this.el("[data-contact-form]");
      form.hidden = locked || !this.copy.payments;
      this.el("[data-pay-action]").hidden = !this.el("[data-outcome]").hidden;
      if (!form.hidden && this.view) this.startSecurityCheck();
    }

    private startSecurityCheck() {
      const payments = this.copy.payments;
      if (!payments) return;
      this.securityCheck ??= renderSecurityCheck(this.el("[data-security-check]"), {
        siteKey: payments.turnstileSiteKey,
        lang: this.copy.lang,
        onError: () => this.showPayError("reservation.pay.error.securityUnavailable"),
      }).catch(() => {
        this.securityCheck = null;
        this.showPayError("reservation.pay.error.securityUnavailable");
        return null;
      });
    }

    private showPayError(key: string) {
      this.el("[data-form-error]").textContent = key ? this.text(key) : "";
    }

    private async pay() {
      if (this.paying || !this.view || !this.copy.payments || !this.validate()) return;
      this.paying = true;
      const button = this.el<HTMLButtonElement>("[data-pay-button]");
      button.disabled = true;
      this.showPayError("");
      try {
        if (!(await this.acceptBeforePaying())) return;
        if (!(await this.confirmNoOpenPayment())) return;
        if (!(await this.ensureAcceptedQuote()) || !this.view || !this.copy.payments) return;
        const security = await this.securityCheck;
        const turnstileToken = security?.token() ?? "";
        if (!turnstileToken) return this.showPayError("reservation.pay.error.security");
        let sourceId: string | null;
        try {
          sourceId = await openCardForm({
            publicKey: this.copy.payments.culqiPublicKey,
            title: this.copy.payments.title,
            amountCents: this.view.quote.requiredInitialPaymentCents,
            currency: this.view.currency,
            email: this.contact().email,
            lang: this.copy.lang,
          });
        } catch {
          return this.showPayError("reservation.pay.error.card");
        }
        if (!sourceId || !this.view || !this.copy.payments) return;
        const fingerprint = await deviceFingerprint({
          publicKey: this.copy.payments.culqiPublicKey,
          amountCents: this.view.quote.requiredInitialPaymentCents,
          currency: this.view.currency,
          email: this.contact().email,
        });
        await this.sendPayment(sourceId, turnstileToken, security, fingerprint);
      } finally {
        this.paying = false;
        button.disabled = false;
      }
    }

    private async confirmNoOpenPayment() {
      const current = await readPayment(this.copy.apiBase, this.token);
      if (current.kind === "payment") {
        if (current.payment && !allowsNewPayment(current.payment)) {
          this.markSubmitted(null);
          this.showPayment(current.payment, true);
          return false;
        }
        return true;
      }
      if (current.kind === "denied") {
        await this.load();
        return false;
      }
      this.showPayError(payErrorCopy[current.kind] ?? "reservation.pay.error.unavailable");
      return false;
    }

    private async ensureAcceptedQuote() {
      if (!this.view) return false;
      if (quoteStillValid(this.view)) return this.serverAccepted(this.view);
      return this.applyRefresh(await refreshQuote(this.copy.apiBase, this.token));
    }

    private async applyRefresh(outcome: CheckoutOutcome) {
      if (outcome.kind === "has_payment") {
        await this.syncPayment(true);
        return false;
      }
      if (outcome.kind === "limited") return this.keepCheckoutAtAgreementCap();
      if (outcome.kind === "ready") {
        if (this.serverAccepted(outcome.view)) {
          this.keepRefreshedAgreement(outcome);
          return true;
        }
        this.showChangedOffer(outcome);
        return false;
      }
      this.settle(outcome);
      return false;
    }

    private installRefreshedQuote(outcome: Ready) {
      this.token = outcome.token || this.token;
      this.view = outcome.view;
      this.render(outcome.view);
      this.el("[data-review]").hidden = false;
      this.el("[data-problem]").hidden = true;
    }

    private keepRefreshedAgreement(outcome: Ready) {
      const stored = this.stored();
      this.installRefreshedQuote(outcome);
      storeCheckout(this.key, {
        token: this.token,
        agreedOffer: offerKey(outcome.view),
        accepted: {
          quoteId: outcome.view.quote.id,
          contact: stored?.accepted?.contact ?? contactKey(this.contact()),
        },
        submitted: stored?.submitted ?? null,
      });
      this.input("agree").checked = true;
      this.el("[data-changed]").hidden = true;
      this.el("[data-form-error]").textContent = "";
      this.showCheckout();
    }

    private showChangedOffer(outcome: Ready) {
      const stored = this.stored();
      this.installRefreshedQuote(outcome);
      if (stored)
        storeCheckout(this.key, {
          ...stored,
          token: this.token,
          agreedOffer: null,
          accepted: null,
        });
      this.input("agree").checked = false;
      this.el("[data-changed]").hidden = false;
      this.el("[data-form-error]").textContent = this.text("reservation.pay.changed");
      this.showCheckout();
      this.input("agree").focus();
    }

    private keepCheckoutAtAgreementCap() {
      this.el("[data-review]").hidden = false;
      this.el("[data-problem]").hidden = true;
      this.el("[data-form-error]").textContent = this.text("reservation.pay.error.limited");
      return false;
    }

    private async sendPayment(
      sourceId: string,
      turnstileToken: string,
      security: SecurityCheck | null,
      fingerprint: string | null,
    ) {
      this.el("[data-status]").textContent = this.text("reservation.pay.sending");
      this.markSubmitted(this.view!.quote.id);
      let outcome = await startPayment(this.copy.apiBase, this.token, {
        quoteId: this.view!.quote.id,
        sourceId,
        turnstileToken,
        ...(fingerprint ? { deviceFingerprint: fingerprint } : {}),
      });
      if (outcome.kind === "expired" || outcome.kind === "replaced") {
        const recovered = await this.recoverRejectedCharge(
          outcome,
          sourceId,
          turnstileToken,
          fingerprint,
        );
        if (!recovered) {
          security?.reset();
          return;
        }
        outcome = recovered;
      }
      security?.reset();
      this.rememberCreatedCard(outcome, sourceId);
      await this.settlePayment(outcome);
    }

    private async recoverRejectedCharge(
      outcome: Extract<PaymentOutcome, { kind: "expired" | "replaced" }>,
      sourceId: string,
      turnstileToken: string,
      fingerprint: string | null,
    ): Promise<PaymentOutcome | null> {
      const reviewed = this.view ? offerKey(this.view) : "";
      const current =
        outcome.kind === "expired"
          ? await refreshQuote(this.copy.apiBase, this.token)
          : await readCheckout(this.copy.apiBase, this.token);
      if (current.kind === "has_payment") return readPayment(this.copy.apiBase, this.token);
      if (current.kind === "limited") {
        this.keepCheckoutAtAgreementCap();
        return null;
      }
      if (current.kind !== "ready") {
        this.settle(current);
        return null;
      }
      if (!this.sameAcceptedOffer(current.view, reviewed)) {
        this.showChangedOffer(current);
        return null;
      }
      this.keepRefreshedAgreement(current);
      this.markSubmitted(current.view.quote.id);
      const retried = await startPayment(this.copy.apiBase, this.token, {
        quoteId: current.view.quote.id,
        sourceId,
        turnstileToken,
        ...(fingerprint ? { deviceFingerprint: fingerprint } : {}),
      });
      if (retried.kind !== "expired" && retried.kind !== "replaced") return retried;
      const latest = await readCheckout(this.copy.apiBase, this.token);
      if (latest.kind === "ready" && this.sameAcceptedOffer(latest.view, reviewed))
        this.keepRefreshedAgreement(latest);
      else if (latest.kind === "ready") this.showChangedOffer(latest);
      else if (latest.kind === "limited") this.keepCheckoutAtAgreementCap();
      else this.settle(latest);
      return null;
    }

    private sameAcceptedOffer(view: CheckoutView, reviewed: string) {
      return this.serverAccepted(view) && offerKey(view) === reviewed;
    }

    private rememberCreatedCard(outcome: PaymentOutcome, sourceId: string) {
      if (
        outcome.kind !== "payment" ||
        !outcome.created ||
        !outcome.payment?.attemptId ||
        !this.key
      )
        return;
      storeCard(this.key, { sourceId, attemptId: outcome.payment.attemptId });
    }

    private forgetCardSource() {
      if (this.key) clearCardSource(this.key);
    }

    private cardSource() {
      return this.key ? storedCard(this.key) : null;
    }

    private cardFor(payment: GuestPayment | null) {
      const stored = this.cardSource();
      if (!stored || !payment?.attemptId || stored.attemptId !== payment.attemptId) return null;
      return stored.sourceId;
    }

    private markSubmitted(quoteId: string | null) {
      const stored = this.stored();
      if (stored) storeCheckout(this.key, { ...stored, submitted: quoteId });
    }

    private submittedPayment(): GuestPayment | null {
      const view = this.view;
      if (!view || this.stored()?.submitted !== view.quote.id) return null;
      return {
        attemptId: this.cardSource()?.attemptId ?? "",
        state: "submitted",
        amountCents: view.quote.requiredInitialPaymentCents,
        currency: view.currency,
        delayed: false,
        reservation: null,
      };
    }

    private async settlePayment(outcome: PaymentOutcome) {
      this.el("[data-status]").textContent = "";
      if (outcome.kind === "unavailable") {
        const current = await readPayment(this.copy.apiBase, this.token);
        if (current.kind === "payment" && current.payment) this.markSubmitted(null);
        return this.showPayment(
          current.kind === "payment" && current.payment ? current.payment : this.submittedPayment(),
          true,
        );
      }
      this.markSubmitted(null);
      if (outcome.kind === "payment") return this.showPayment(outcome.payment, true);
      if (outcome.kind === "sold_out") return this.showProblem({ kind: "sold_out" });
      if (outcome.kind === "denied") return this.load();
      if (outcome.kind === "invalid" && backendProblems[outcome.error])
        return this.showProblem(outcome);
      if (outcome.kind === "expired" || outcome.kind === "replaced") {
        this.el("[data-form-error]").textContent = this.text("reservation.pay.changed");
        return;
      }
      this.showPayError(payErrorCopy[outcome.kind] ?? "reservation.pay.error.unavailable");
    }

    private awaitingStatus() {
      const state = this.payment?.state;
      return (
        state === "processing" ||
        state === "authentication_required" ||
        state === "paid_awaiting_reservation" ||
        state === "submitted" ||
        this.stored()?.submitted != null
      );
    }

    private scheduleStatusPoll() {
      clearTimeout(this.poll);
      if (this.awaitingStatus())
        this.poll = setTimeout(() => void this.syncPayment(), PAYMENT_POLL_MS);
    }

    private async syncPayment(announce = false) {
      clearTimeout(this.poll);
      if (!this.token) return;
      if (announce)
        this.el("[data-status]").textContent = this.text("reservation.outcome.checking");
      const outcome = await readPayment(this.copy.apiBase, this.token);
      if (announce) this.el("[data-status]").textContent = "";
      if (outcome.kind !== "payment") {
        this.scheduleStatusPoll();
        return;
      }
      if (outcome.payment) this.markSubmitted(null);
      this.showPayment(outcome.payment ?? this.submittedPayment(), announce);
    }

    private payAgain() {
      this.el("[data-outcome]").hidden = true;
      this.showCheckout();
      this.querySelector<HTMLElement>("[data-pay-button]")?.focus();
    }

    private showPayment(payment: GuestPayment | null, focus = false) {
      this.payment = payment;
      const outcome = this.el("[data-outcome]");
      outcome.hidden = !payment;
      if (payment) this.renderOutcome(payment);
      void this.showAccess(payment);
      if (
        payment &&
        (payment.state === "declined" ||
          payment.state === "confirmed" ||
          payment.state === "unfulfilled" ||
          payment.state === "reservation_changed" ||
          payment.state === "paid_awaiting_reservation")
      )
        this.forgetCardSource();
      this.showCheckout();
      if (payment && focus) this.el("[data-outcome-title]").focus();
      if (payment?.state === "authentication_required") this.maybeOpenBank();
      if (payment && VERIFYING.includes(payment.state) && !payment.delayed)
        this.poll = setTimeout(() => void this.syncPayment(), PAYMENT_POLL_MS);
    }

    private maybeOpenBank() {
      const source = this.cardFor(this.payment);
      if (!source || this.openedBankFor === source) return;
      this.openedBankFor = source;
      void this.openBank();
    }

    private async openBank() {
      const sourceId = this.cardFor(this.payment);
      const payments = this.copy.payments;
      const view = this.view;
      if (!sourceId || !payments || !view) return;
      try {
        await openBankAuthentication({
          publicKey: payments.culqiPublicKey,
          amountCents: this.payment?.amountCents ?? view.quote.requiredInitialPaymentCents,
          currency: view.currency,
          email: this.contact().email,
          sourceId,
          onParameters: (parameters) => void this.finishAuthentication(parameters),
          onIncomplete: () => this.showAuthenticationIncomplete(),
        });
      } catch {
        this.showAuthenticationIncomplete();
      }
    }

    private showAuthenticationIncomplete() {
      if (
        this.payment &&
        this.payment.state !== "authentication_required" &&
        this.payment.state !== "submitted"
      )
        return;
      const pending =
        this.payment?.state === "authentication_required" ? this.payment : this.waitingForBank();
      if (!pending) return;
      this.showPayment(pending, false);
      this.el("[data-outcome-bank]").focus();
    }

    private waitingForBank(): GuestPayment | null {
      const view = this.view;
      if (!view) return null;
      return {
        attemptId: this.cardSource()?.attemptId ?? "",
        state: "authentication_required",
        amountCents: view.quote.requiredInitialPaymentCents,
        currency: view.currency,
        delayed: false,
        reservation: null,
      };
    }

    private async finishAuthentication(parameters: AuthenticationParameters) {
      const attemptId = this.cardFor(this.payment) ? this.payment?.attemptId : null;
      if (!this.view || !this.token || !attemptId) return;
      this.markSubmitted(this.view.quote.id);
      const outcome = await continuePayment(this.copy.apiBase, this.token, {
        ...parameters,
        attemptId,
      });
      if (outcome.kind === "payment" || outcome.kind === "unavailable") {
        await this.settlePayment(outcome);
        return;
      }
      const current = await readPayment(this.copy.apiBase, this.token);
      if (current.kind === "payment" && current.payment) this.markSubmitted(null);
      this.showPayment(
        current.kind === "payment" && current.payment ? current.payment : this.submittedPayment(),
        true,
      );
    }

    private renderOutcome(payment: GuestPayment) {
      const box = this.el("[data-outcome-box]");
      for (const tone of new Set(Object.values(outcomeTone))) box.classList.remove(tone);
      box.classList.add(outcomeTone[payment.state]);
      const key = `reservation.outcome.${payment.state}`;
      this.el("[data-outcome-title]").textContent = this.text(`${key}.title`);
      this.el("[data-outcome-body]").textContent = this.text(
        payment.state === "processing" && payment.delayed
          ? "reservation.outcome.processing.delayed"
          : `${key}.body`,
      );
      const money = (cents: number) => formatMoney(cents, payment.currency);
      const { reservation } = payment;
      const rows: [string, string][] =
        payment.state === "confirmed" && reservation
          ? [
              ["reservation.outcome.reference", reservation.code],
              ["reservation.outcome.paid", money(reservation.paidCents)],
              ["reservation.outcome.outstanding", money(reservation.outstandingCents)],
            ]
          : payment.state === "unfulfilled" && reservation
            ? [
                ["reservation.outcome.supportReference", reservation.code],
                ["reservation.outcome.received", money(reservation.paidCents)],
                ["reservation.outcome.awaiting", money(reservation.refundDueCents)],
              ]
            : reservation
              ? [
                  ["reservation.outcome.reference", reservation.code],
                  ["reservation.outcome.paid", money(reservation.paidCents)],
                ]
              : [["reservation.outcome.amount", money(payment.amountCents)]];
      this.el("[data-outcome-amounts]").replaceChildren(
        ...rows.map(([label, value]) => {
          const row = document.createElement("div");
          row.className = "flex items-baseline justify-between gap-4 py-2";
          const term = document.createElement("dt");
          term.className = "text-stone-700";
          term.textContent = this.text(label);
          const detail = document.createElement("dd");
          detail.className = "text-right font-semibold text-stone-900";
          detail.textContent = value;
          row.append(term, detail);
          return row;
        }),
      );
      this.el("[data-outcome-retry]").hidden = !allowsNewPayment(payment) || !this.copy.payments;
      this.el("[data-outcome-bank]").hidden =
        payment.state !== "authentication_required" || !this.cardFor(payment);
      this.el("[data-access]").hidden = true;
      this.el("[data-outcome-check]").hidden = !(
        payment.state === "submitted" ||
        payment.state === "authentication_required" ||
        (VERIFYING.includes(payment.state) && payment.delayed)
      );
    }

    private async showAccess(payment: GuestPayment | null) {
      const panel = this.el("[data-access]");
      const saved =
        payment?.state === "confirmed" ||
        payment?.state === "unfulfilled" ||
        payment?.state === "reservation_changed";
      const request = ++this.accessRequest;
      this.accessToken = null;
      panel.hidden = true;
      this.el("[data-access-copied]").hidden = true;
      if (!saved || !this.token) return;
      const access = await readCheckoutAccess(this.copy.apiBase, this.token);
      if (request !== this.accessRequest) return;
      if (!access) return;
      this.accessToken = access.token;
      if (payment.state === "confirmed" && payment.reservation) {
        storeConfirmedReservation(payment.reservation.code);
        window.location.replace(summaryLink(this.copy.summaryHref, access.token));
        return;
      }
      panel.hidden = false;
    }

    private async copyAccessLink() {
      if (!this.accessToken) return;
      const feedback = this.el("[data-access-copied]");
      try {
        await navigator.clipboard.writeText(summaryLink(this.copy.summaryHref, this.accessToken));
        feedback.hidden = false;
      } catch {
        feedback.hidden = true;
      }
    }

    private showFieldError(id: ContactField | "agree", message: string) {
      const input = this.input(id);
      const error = this.el(`#${id}-error`);
      error.textContent = message;
      error.hidden = !message;
      if (message) input.setAttribute("aria-invalid", "true");
      else input.removeAttribute("aria-invalid");
    }

    private validate() {
      const contact = this.contact();
      const problems: [ContactField | "agree", string][] = [];
      if (!contact.fullName) problems.push(["fullName", "reservation.review.error.fullName"]);
      if (!EMAIL.test(contact.email)) problems.push(["email", "reservation.review.error.email"]);
      if (!contact.phone) problems.push(["phone", "reservation.review.error.phone"]);
      if (!this.input("agree").checked) problems.push(["agree", "reservation.review.error.agree"]);
      for (const id of [...contactFields, "agree"] as const) {
        const problem = problems.find(([field]) => field === id);
        this.showFieldError(id, problem ? this.text(problem[1]) : "");
      }
      if (problems.length) this.input(problems[0]![0]).focus();
      return problems.length === 0;
    }

    private accept() {
      return acceptQuote(this.copy.apiBase, this.token, {
        quoteId: this.view!.quote.id,
        language: this.copy.lang,
        contact: this.contact(),
      });
    }

    private async acceptCurrentOffer(): Promise<CheckoutOutcome | null> {
      const outcome = await this.accept();
      if (!["expired", "replaced", "denied"].includes(outcome.kind)) return outcome;
      const before = offerKey(this.view!);
      const current =
        outcome.kind === "expired"
          ? await refreshQuote(this.copy.apiBase, this.token)
          : await this.currentQuote();
      if (current.kind === "has_payment") return current;
      if (current.kind !== "ready") return current;
      this.ready(current);
      if (offerKey(current.view) === before) return this.accept();
      this.input("agree").checked = false;
      this.el("[data-changed]").hidden = false;
      this.input("agree").focus();
      return null;
    }

    private async acceptBeforePaying() {
      if (this.isAccepted()) return true;
      this.el("[data-status]").textContent = this.text("reservation.review.saving");
      const outcome = await this.acceptCurrentOffer();
      this.el("[data-status]").textContent = "";
      if (!outcome) return false;
      if (outcome.kind === "has_payment") {
        await this.syncPayment(true);
        return false;
      }
      if (outcome.kind !== "ready") {
        this.settle(outcome);
        return false;
      }
      this.view = outcome.view;
      const stored = this.stored();
      if (stored)
        storeCheckout(this.key, {
          ...stored,
          accepted: { quoteId: outcome.view.quote.id, contact: contactKey(this.contact()) },
        });
      return true;
    }

    private settle(outcome: Exclude<CheckoutOutcome, Ready>) {
      this.el("[data-status]").textContent = "";
      if (outcome.kind === "invalid" && contactProblems[outcome.error]) {
        const [field, key] = contactProblems[outcome.error]!;
        this.showFieldError(field, this.text(key));
        return this.input(field).focus();
      }
      if (outcome.kind === "invalid" && backendProblems[outcome.error])
        return this.showProblem(outcome);
      const formError = formErrorCopy[outcome.kind];
      if (formError) {
        this.el("[data-form-error]").textContent = this.text(formError);
        return;
      }
      const stored = this.stored();
      if (outcome.kind === "limited" && stored)
        storeCheckout(this.key, { ...stored, token: "", accepted: null });
      this.showProblem(outcome);
    }

    private showProblem(problem: Problem) {
      const copy = problemCopy[problem.kind];
      const room = this.search.room ? (this.copy.rooms[this.search.room]?.name ?? "") : "";
      const body =
        problem.kind === "invalid" ? (backendProblems[problem.error] ?? copy.body) : copy.body;
      this.el("[data-status]").textContent = "";
      this.el("[data-review]").hidden = true;
      this.el("[data-problem]").hidden = false;
      this.el("[data-problem-title]").textContent = this.text(copy.title, { room });
      this.el("[data-problem-body]").textContent = this.text(body, { room });
      this.el("[data-retry]").hidden = !copy.retry;
      this.el("[data-problem-title]").focus();
    }
  }
  customElements.define("reservation-review", ReservationReview);
</script>
