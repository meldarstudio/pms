---
import { getWhatsAppLink } from "@/lib/constants";
import { getLang, useTranslations } from "@/i18n/utils";

interface Props {
  kicker?: string | false;
  title?: string;
  body?: string;
  cta?: string;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const {
  kicker = t("booking.kicker"),
  title = t("booking.title"),
  body = t("booking.body"),
  cta = t("booking.cta"),
} = Astro.props;
const bookHref = getWhatsAppLink(t("whatsapp.prefill"));
---

<section class="bg-stone-100">
  <div class="mx-auto max-w-7xl px-4 py-8 md:px-8 md:py-16 lg:py-24">
    <div class="border border-stone-200 bg-white p-8 md:p-12 lg:p-16">
      <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
        <div class="max-w-xl min-w-0">
          {kicker && (
            <p class="font-source-sans-3 text-accent-700 mb-4 text-xs font-medium tracking-widest uppercase">
              {kicker}
            </p>
          )}
          <h2 class="text-2xl font-semibold text-pretty text-stone-900 md:text-3xl lg:text-4xl">
            {title}
          </h2>
          <p class="mt-4 text-base leading-relaxed text-pretty text-stone-600">{body}</p>
        </div>

        <a
          href={bookHref}
          target="_blank"
          rel="noopener noreferrer"
          class="font-source-sans-3 bg-accent-500 text-accent-950 hover:bg-accent-400 inline-flex min-h-11 w-fit shrink-0 items-center px-8 text-sm font-medium tracking-widest uppercase"
        >
          {cta}
        </a>
      </div>
    </div>
  </div>
</section>
