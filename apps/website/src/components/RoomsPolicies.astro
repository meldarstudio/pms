---
import { getLang, useTranslations } from "@/i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const facts = [
  {
    label: t("rooms.policies.checkIn"),
    value: t("rooms.policies.checkInValue"),
  },
  {
    label: t("rooms.policies.checkOut"),
    value: t("rooms.policies.checkOutValue"),
  },
  {
    label: t("rooms.policies.payment"),
    value: t("rooms.policies.paymentValue"),
  },
  {
    label: t("rooms.policies.deposit"),
    value: t("rooms.policies.depositValue"),
  },
  {
    label: t("rooms.policies.breakfast"),
    value: t("rooms.policies.breakfastValue"),
  },
  {
    label: t("rooms.policies.petsTitle"),
    value: t("rooms.policies.petsBody"),
  },
] as const;
---

<section class="bg-stone-100">
  <div class="mx-auto max-w-7xl px-4 py-8 md:px-8 md:py-16 lg:py-24">
    <div class="grid border border-stone-200 bg-white md:grid-cols-12">
      <div class="p-6 md:col-span-7 md:p-10">
        <h2 class="text-2xl font-semibold text-pretty text-stone-900 md:text-3xl lg:text-4xl">
          {t("rooms.policies.title")}
        </h2>
        <dl class="mt-8 flex flex-col gap-5">
          {facts.map((fact) => (
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-3">
              <dt class="font-source-sans-3 text-accent-700 shrink-0 text-xs font-medium tracking-widest uppercase">
                {fact.label}
              </dt>
              <span
                class="mb-1 hidden min-w-8 flex-1 self-end border-b border-dotted border-stone-300 sm:block"
                aria-hidden="true"
              />
              <dd class="leading-relaxed text-pretty text-stone-900 sm:text-right">{fact.value}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="bg-accent-500 text-accent-950 selection:bg-accent-950 p-6 selection:text-white md:col-span-5 md:p-10">
        <h3 class="text-lg font-semibold text-pretty">{t("rooms.policies.cancelTitle")}</h3>
        <span class="bg-accent-950 mt-5 block h-px w-12" aria-hidden="true"></span>
        <p class="mt-5 leading-relaxed text-pretty">{t("rooms.policies.cancelBody")}</p>
      </div>
    </div>
  </div>
</section>
