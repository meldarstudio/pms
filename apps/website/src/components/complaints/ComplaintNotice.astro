---
import { developmentComplaintPreview } from "@/lib/complaints";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLang, useTranslations } from "@/i18n/utils";
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

{developmentComplaintPreview && (
  <aside
    class="mx-auto max-w-7xl border-y border-stone-200 px-4 py-6 md:px-8"
    aria-label="Libro de Reclamaciones"
  >
    <a
      class="inline-flex min-h-11 items-center text-xl underline"
      href={getRelativeLocaleUrl(lang, "libro-de-reclamaciones")}
    >
      Libro de Reclamaciones
    </a>
    <p>{t("complaints.developmentPreviewNotActiveForProduction")}</p>
  </aside>
)}
