---
import { Image } from "astro:assets";
import { developmentComplaintPreview } from "@/lib/complaints";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLang, useTranslations } from "@/i18n/utils";
import aviso from "@/assets/libro-de-reclamaciones-aviso.png";
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

{developmentComplaintPreview && (
  <aside
    class="mx-auto flex max-w-7xl flex-col items-start gap-3 px-4 py-6 md:px-8"
    aria-label="Libro de Reclamaciones"
  >
    <a
      class="block w-60 border border-stone-900 bg-white p-2 focus-visible:outline-2 focus-visible:outline-offset-2"
      href={getRelativeLocaleUrl(lang, "libro-de-reclamaciones")}
    >
      <Image src={aviso} alt="Libro de Reclamaciones" width={443} class="h-auto w-full" />
    </a>
    <p>{t("complaints.developmentPreviewNotActiveForProduction")}</p>
  </aside>
)}
