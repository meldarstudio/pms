---
import { PUBLIC_TURNSTILE_SITE_KEY } from "astro:env/client";
import Layout from "@/layouts/Layout.astro";
import { getLang } from "@/i18n/utils";
import { privacyHref } from "@/lib/reservation/links";
import { ComplaintBook } from "./ComplaintBook";
const language = getLang(Astro.currentLocale);
---

<Layout title="Libro de Reclamaciones" noIndex>
  <div class="complaint-page mx-auto max-w-3xl px-4 py-10 md:py-14">
    <h1 class="mb-5 text-3xl leading-tight font-semibold text-stone-900 md:text-4xl">
      Libro de Reclamaciones
    </h1>
    <ComplaintBook
      client:load
      language={language}
      privacyHref={privacyHref(language)}
      turnstileSiteKey={
        PUBLIC_TURNSTILE_SITE_KEY ?? (import.meta.env.DEV ? "1x00000000000000000000AA" : null)
      }
    />
  </div>
</Layout>
<style is:global>
  @media print {
    body:has(.complaint-sheet) header,
    body:has(.complaint-sheet) footer,
    body:has(.complaint-sheet) nav {
      display: none !important;
    }
    .complaint-sheet {
      color: black;
      background: white;
      font-size: 11pt;
    }
    .complaint-sheet div {
      break-inside: avoid;
    }
  }
</style>
