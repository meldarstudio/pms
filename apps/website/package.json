{
  "name": "@pms/website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro sync && astro-check",
    "test:smoke": "pnpm verify:build && playwright test --project=smoke",
    "verify:build": "pnpm build && node scripts/verify-build.mjs",
    "test:links": "pnpm build && node scripts/check-links.mjs",
    "preview": "astro preview",
    "test:a11y": "pnpm verify:build && playwright test --project=a11y"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.4",
    "astro": "7.4.5",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "wrangler": "4.156.2"
  }
}
