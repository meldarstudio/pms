{
  "name": "@pms/website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "vp lint . && astro sync && astro-check && svelte-check --tsconfig tsconfig.svelte.json",
    "test": "vp test run",
    "test:smoke": "node scripts/build-for-local-api.mjs && playwright test --project=smoke",
    "verify:build": "pnpm build && node scripts/verify-build.mjs",
    "test:links": "pnpm build && node scripts/check-links.mjs",
    "preview": "astro preview",
    "deploy": "pnpm verify:build && cf deploy --prebuilt"
  },
  "dependencies": {
    "@astrojs/cloudflare": "15.0.0-beta.6",
    "@astrojs/sitemap": "3.7.6",
    "@astrojs/svelte": "9.1.6",
    "@pms/shared": "workspace:*",
    "@tailwindcss/vite": "4.3.5",
    "@ui-sdk/core": "0.1.0-beta.17",
    "@ui-sdk/svelte": "0.1.0-beta.17",
    "astro": "7.4.13",
    "country-flag-icons": "^1.6.20",
    "effect": "4.1.5",
    "phosphor-svelte": "3.1.1",
    "sharp": "0.35.5",
    "svelte": "5.59.2",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.65.1",
    "cf": "catalog:",
    "svelte-check": "4.7.8",
    "vite-plus": "catalog:"
  }
}
