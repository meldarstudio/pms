# Copy to .dev.vars. Wrangler reads it for `wrangler dev`; it is git-ignored.
# Generate with: pnpm auth:secret. Accounts live in the local database; see pnpm auth:account.
SESSION_SECRET=
PROPERTY_TIME_ZONE=America/Lima
# The portal's dev origin. It must be localhost, not 127.0.0.1, so the session cookie is same-site.
ALLOWED_ORIGINS=http://localhost:5173
# Culqi sandbox keys from CulqiPanel. Never use live keys locally. The public key is
# only for pnpm culqi:sandbox, which creates test card tokens.
CULQI_SECRET_KEY=
CULQI_PUBLIC_KEY=
