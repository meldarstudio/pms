# Copy to .dev.vars. `cf dev` reads it; it is git-ignored.
# Generate with: pnpm auth:secret. Accounts live in the local database; see pnpm auth:account.
SESSION_SECRET=
PROPERTY_TIME_ZONE=America/Lima
# The portal's dev origin. It must be localhost, not 127.0.0.1, so the session cookie is same-site.
ALLOWED_ORIGINS=http://localhost:5173
# The website's dev origin for guest routes under /public (non-credentialed CORS).
PUBLIC_ALLOWED_ORIGINS=http://localhost:4321
# Culqi sandbox secret from CulqiPanel. Never use live keys locally.
# Set the matching public key as PUBLIC_CULQI_PUBLIC_KEY in the website's .env.development.local.
CULQI_SECRET_KEY=
# Turnstile secret for the website's payment and complaint challenges. Cloudflare's always-passing test
# secret is 1x0000000000000000000000000000000AA.
TURNSTILE_SECRET_KEY=
# Optional. Unset keeps confirmation emails and complaint receipts pending. RESEND_API_URL is ignored unless it is a loopback address.
RESEND_API_KEY=
RESEND_API_URL=
# Optional matching VAPID P-256 keys in base64url form. Web push is unavailable without both.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
