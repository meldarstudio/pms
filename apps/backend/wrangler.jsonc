{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-05",
  "vars": {
    "CURRENCY": "USD"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pms",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "drizzle"
    }
  ]
}
