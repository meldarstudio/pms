{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pms-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api.hotelmanantialchurin.com", "custom_domain": true }],
  "vars": {
    "CURRENCY": "PEN",
    "PROPERTY_TIME_ZONE": "America/Lima",
    "AUTH_USERNAME": "hotelmanantial",
    "ALLOWED_ORIGINS": "https://app.hotelmanantialchurin.com",
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pms-production",
      "database_id": "17e838dd-b2f9-4783-ad9b-f5d837701428",
      "migrations_dir": "drizzle",
    },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
}
