{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pms-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "CURRENCY": "PEN"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pms-production",
      "database_id": "cd3e5df8-7646-44d9-991f-e8b126b40eb3",
      "migrations_dir": "drizzle"
    }
  ]
}
