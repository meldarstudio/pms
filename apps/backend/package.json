{
  "name": "@pms/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "pnpm db:migrate:remote && wrangler deploy --minify",
    "deploy:ci": "wrangler deploy --minify",
    "deploy:preview": "pnpm db:migrate:preview && node ../../scripts/worker-preview.mjs",
    "deploy:preview:ci": "node ../../scripts/worker-preview.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply pms --local",
    "db:migrate:remote": "wrangler d1 migrations apply pms-production --remote",
    "db:migrate:preview": "wrangler d1 migrations apply PREVIEW_DB --remote --config wrangler.preview-migrations.jsonc",
    "db:seed:local": "wrangler d1 execute pms --local --file=./seed.sql",
    "db:reset:local": "node seed-reset.mjs",
    "db:reset:preview": "node seed-reset.mjs --remote-preview",
    "db:seed:unassigned": "node seed-unassigned.mjs"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@pms/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
