{
  "name": "@pms/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "deploy": "wrangler deploy --minify",
    "deploy:ci": "wrangler deploy --minify",
    "test": "vp test run",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "node scripts/migrate-production.mjs",
    "db:seed:local": "wrangler d1 execute DB --local --file=./seed.sql",
    "db:reset:local": "node scripts/seed-reset.mjs",
    "db:seed:unassigned": "node scripts/seed-unassigned.mjs",
    "auth:hash": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@pms/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.147.0"
  }
}
