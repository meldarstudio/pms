{
  "name": "pms",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "dev:portal": "pnpm --filter @pms/portal dev",
    "dev:backend": "pnpm --filter @pms/backend dev",
    "build": "pnpm --filter @pms/portal build",
    "test": "pnpm --filter @pms/backend test",
    "lint": "pnpm --filter @pms/portal lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter @pms/backend db:generate",
    "db:migrate:local": "pnpm --filter @pms/backend db:migrate:local",
    "db:seed:local": "pnpm --filter @pms/backend db:seed:local",
    "db:reset:local": "pnpm --filter @pms/backend db:reset:local"
  }
}
