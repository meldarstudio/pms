{
  "name": "pms",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "dev:portal": "pnpm --filter @pms/portal dev",
    "dev:backend": "pnpm --filter @pms/backend dev",
    "build": "pnpm check && pnpm --filter @pms/portal exec vp build",
    "test": "pnpm --filter @pms/backend test && pnpm --filter @pms/portal test",
    "db:generate": "pnpm --filter @pms/backend db:generate",
    "db:migrate:local": "pnpm --filter @pms/backend db:migrate:local",
    "db:seed:local": "pnpm --filter @pms/backend db:seed:local",
    "db:reset:local": "pnpm --filter @pms/backend db:reset:local",
    "auth:account": "pnpm --filter @pms/backend auth:account",
    "auth:secret": "pnpm --filter @pms/backend auth:secret",
    "culqi:sandbox": "pnpm --filter @pms/backend culqi:sandbox",
    "check": "vp fmt --check . && pnpm -r --workspace-concurrency=1 check",
    "format": "vp fmt ."
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.4",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.15.0"
}
